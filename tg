def build_parser():
    import argparse
    p = argparse.ArgumentParser(prog="tg", description="global Telegram bot CLI (repo-local state)")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("poll"); sub.add_parser("doctor"); sub.add_parser("watch")
    sub.add_parser("media"); sub.add_parser("ids"); sub.add_parser("pending")
    s = sub.add_parser("show"); s.add_argument("msg_id", help="inbound message id (the `#<id>` shown in tg watch/pending)")

    # The target chat is a REQUIRED LEADING positional on every send command: the
    # recipient comes first (like every messaging tool), and the free-form message
    # goes last where a broken shell quote can't swallow it. There is no group
    # default — _to() errors on omission. `--to` is an order-independent alternative.
    def add_target(s):
        s.add_argument("to", nargs="?",
                       help="target chat (required): `group`/`team`, a tg.conf alias, or a numeric id")
        s.add_argument("--to", dest="to_flag", metavar="CHAT",
                       help="target chat as a flag (alternative to the leading positional)")

    s = sub.add_parser("send"); add_target(s); s.add_argument("text", nargs="?")
    s.add_argument("--file", dest="text_file", help="read the message text from FILE (avoids shell-quoting traps)")
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")
    s.add_argument("--html", action="store_true"); s.add_argument("--dry-run", dest="dry_run", action="store_true")

    # reply targets the chat of the message it answers — no [to], by design.
    s = sub.add_parser("reply"); s.add_argument("msg_id"); s.add_argument("text", nargs="?")
    s.add_argument("--file", dest="text_file", help="read the reply text from FILE (avoids shell-quoting traps)")
    s.add_argument("--html", action="store_true")

    s = sub.add_parser("sendvoice"); add_target(s); s.add_argument("text")

    s = sub.add_parser("senddoc"); add_target(s); s.add_argument("path")
    s.add_argument("--caption"); s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")

    s = sub.add_parser("sendphoto"); add_target(s); s.add_argument("path")
    s.add_argument("--caption"); s.add_argument("--html", action="store_true")
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")

    # Options are variadic, so the target can't be a leading positional here — it
    # comes from --to (now required, like everywhere: no group default).
    s = sub.add_parser("sendpoll"); s.add_argument("question"); s.add_argument("options", nargs="+")
    s.add_argument("--to", dest="to_flag", metavar="CHAT",
                   help="target chat (required): `group`/`team`, a tg.conf alias, or a numeric id")
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")
    s.add_argument("--multi", action="store_true", help="allow multiple answers (regular poll)")
    s.add_argument("--quiz", type=int, metavar="N", help="quiz poll; N = 0-based index of the correct option")
    s.add_argument("--public", action="store_true", help="non-anonymous poll (default: anonymous)")
    s.add_argument("--dry-run", dest="dry_run", action="store_true")

    s = sub.add_parser("pollstatus")
    s.add_argument("msg_id", nargs="?", help="the poll's message id (omit for the most recent poll)")
    s.add_argument("--poll-id", dest="poll_id", help="target by Telegram poll_id instead of message id")

    # react / delete are message-id-primary: the chat is resolved from history by
    # msg_id (like reply), so no positional target — --to only overrides it.
    s = sub.add_parser("react"); s.add_argument("msg_id"); s.add_argument("emoji", nargs="?")
    s.add_argument("--to", dest="to_flag", metavar="CHAT",
                   help="override target chat (default: the message's chat, from history)")
    s = sub.add_parser("reactions"); add_target(s)
    s = sub.add_parser("delete"); s.add_argument("msg_id")
    s.add_argument("--to", dest="to_flag", metavar="CHAT",
                   help="override target chat (default: the message's chat, from history)")

    s = sub.add_parser("ack"); add_target(s)
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")

    s = sub.add_parser("topics"); s.add_argument("sub", nargs="?"); s.add_argument("args", nargs="*")
    return p


def main():
    a = build_parser().parse_args()
    ctx = Ctx()
    globals()["cmd_%s" % a.cmd](ctx, a)


if __name__ == "__main__":
    main()
