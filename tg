def cmd_pending(ctx, _a):
    """Chats (and forum threads) whose latest inbound message is newer than our
    latest reply OR ack there — i.e. still needs attention. A pure read of
    history.jsonl (no token needed conceptually); this is the reconcile backstop a
    session runs after (re-)arming `tg watch`, to catch anything that landed while
    the live Monitor was down. An `ack` clears a chat without a reply (seen, nothing
    to answer), so chatter/FYIs you won't answer don't linger here forever;
    reactions / membership / meta rows don't count as messages to answer; forum
    topics are keyed per-thread so a reply in one thread doesn't mask an unanswered
    message in another."""
    if not os.path.exists(ctx.hist):
        print("no history yet — poll first"); return
    last_in, last_out, last_ack, who, msgs = {}, {}, {}, {}, {}
    with open(ctx.hist, encoding="utf-8") as f:
        for line in f:
            try:
                r = json.loads(line)
            except Exception:
                continue
            d = r.get("date")
            if d is None:                       # undated rows (failed sends, deletes) carry no ordering
                continue
            cid = (r.get("chat") or {}).get("id")
            if cid is None:
                continue
            key = (cid, r.get("thread_id"))
            if r.get("direction") == "in" and not r.get("kind"):   # real inbound message only
                if d >= last_in.get(key, -1):
                    last_in[key] = d
                    who[key] = (r.get("from") or {}).get("first_name") or "?"
                msgs.setdefault(key, []).append((d, r.get("text") or "[%s]" % (r.get("media") or "non-text"),
                                                 r.get("message_id")))
            elif r.get("direction") == "out":
                last_out[key] = max(d, last_out.get(key, -1))
            elif r.get("kind") == "ack":         # seen, no reply needed — clears like a reply
                last_ack[key] = max(d, last_ack.get(key, -1))
    def seen(key):                               # watermark: replied-to OR acked, whichever is later
        return max(last_out.get(key, -1), last_ack.get(key, -1))
    rows = [(din, key) for key, din in last_in.items() if din > seen(key)]
    if not rows:
        print("all caught up — no unanswered inbound"); return
    for din, key in sorted(rows):
        cid, tid = key
        wm = seen(key)
        unanswered = [(mid, t) for (dd, t, mid) in sorted(msgs.get(key, [])) if dd > wm]
        iso = datetime.datetime.fromtimestamp(din, datetime.UTC).isoformat()
        alias = ctx.chat_alias(cid)
        loc = (alias + " " if alias else "") + str(cid) + ("" if tid is None else " thread %s" % tid)
        print("%-30s %-12s %d unanswered, last %s" % (loc, who.get(key, "?"), len(unanswered), iso))
        for mid, t in unanswered[-3:]:
            print("    #%-9s %s" % (mid, t.replace("\n", " ")[:110]))
    print("→ `tg reply <#id> <text>` to answer in place, or `tg ack <chat>` for anything that needs no answer")


def cmd_ack(ctx, a):
    """Mark a chat/thread as SEEN — acknowledged, no reply needed — so it stops
    showing in `tg pending`. Sets a watermark at the latest inbound timestamp there
    at ack time; anything that arrives later re-surfaces. Lets you clear chatter /
    FYIs / thanks you legitimately won't answer without sending a reply. Silent —
    writes only a local history row; to acknowledge VISIBLY to the sender, react
    instead (`tg react`)."""
    to = ctx.resolve_chat(_to(a))
    if not to:
        die("ack: no target chat", 2)
    thread = _thread_for(ctx, a.topic, a.topic_id)
    tid = int(thread) if thread else None
    latest = None
    if os.path.exists(ctx.hist):
        with open(ctx.hist, encoding="utf-8") as f:
            for line in f:
                try:
                    r = json.loads(line)
                except Exception:
                    continue
                if r.get("direction") != "in" or r.get("kind"):
                    continue
                if (r.get("chat") or {}).get("id") != int(to) or r.get("thread_id") != tid:
                    continue
                d = r.get("date")
                if d is not None and (latest is None or d > latest):
                    latest = d
    loc = "%s%s" % (to, "" if tid is None else " thread %s" % tid)
    if latest is None:
        print("ack: nothing inbound to ack in %s" % loc); return
    row = {"kind": "ack", "direction": "meta", "chat": {"id": int(to)}, "thread_id": tid,
           "date": latest, "iso": datetime.datetime.fromtimestamp(latest, datetime.UTC).isoformat()}
    with open(ctx.hist, "a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")
    print("ack: %s — seen through %s" % (loc, row["iso"]))


def cmd_topics(ctx, a):
    sub = a.sub or "list"
    if sub == "list":
        m = topics_load(ctx.topics)
        if not m:
            print("(no topics cached yet — appear when the poller sees forum_topic_created,"
                  " or add via: tg topics set <name> <thread_id>)")
            return
        for k, v in sorted(m.items(), key=lambda kv: kv[1]):
            print("  #%-24s %s" % (k, v))
    elif sub == "resolve":
        tid = topics_resolve(ctx.topics, a.args[0])
        if tid is None:
            sys.exit(3)
        print(tid)
    elif sub == "set":
        norm = topics_upsert(ctx.topics, int(a.args[1]), a.args[0])
        print("topics: #%s → %s" % (norm, a.args[1]))
    elif sub == "rm":
        m = topics_load(ctx.topics)
        norm = topic_normalize(a.args[0])
        if norm not in m:
            die("no topic '%s' cached" % norm)
        del m[norm]; topics_save(ctx.topics, m)
        print("topics: removed #%s" % norm)
    else:
        die("unknown topics subcommand: %s" % sub, 2)


def _which(prog):
    return any(os.access(os.path.join(p, prog), os.X_OK)
               for p in os.environ.get("PATH", "").split(os.pathsep))


# ── CLI ───────────────────────────────────────────────────────────────────────

def build_parser():
    import argparse
    p = argparse.ArgumentParser(prog="tg", description="global Telegram bot CLI (repo-local state)")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("poll"); sub.add_parser("doctor"); sub.add_parser("watch")
    sub.add_parser("media"); sub.add_parser("ids"); sub.add_parser("pending")

    # The target chat is a uniform optional TRAILING positional, defaulting to
    # the group; `--to` stays as a hidden legacy alias (see _to()).
    def add_to(s):
        s.add_argument("to", nargs="?", help="target chat (tg.conf alias or id); omit for the group")
        s.add_argument("--to", dest="to_flag", help=argparse.SUPPRESS)

    s = sub.add_parser("send"); s.add_argument("text"); add_to(s)
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")
    s.add_argument("--html", action="store_true"); s.add_argument("--dry-run", dest="dry_run", action="store_true")

    # reply targets the chat of the message it answers — no [to], by design.
    s = sub.add_parser("reply"); s.add_argument("msg_id"); s.add_argument("text")
    s.add_argument("--html", action="store_true")

    s = sub.add_parser("sendvoice"); s.add_argument("text"); add_to(s)

    s = sub.add_parser("senddoc"); s.add_argument("path"); add_to(s)
    s.add_argument("--caption"); s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")

    s = sub.add_parser("sendphoto"); s.add_argument("path"); add_to(s)
    s.add_argument("--caption"); s.add_argument("--html", action="store_true")
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")

    # Options are variadic, so [to] can't be a trailing positional here — target
    # comes from --to (defaults to the group), unlike the other send* commands.
    s = sub.add_parser("sendpoll"); s.add_argument("question"); s.add_argument("options", nargs="+")
    s.add_argument("--to", dest="to_flag", help="target chat (tg.conf alias or id); omit for the group")
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")
    s.add_argument("--multi", action="store_true", help="allow multiple answers (regular poll)")
    s.add_argument("--quiz", type=int, metavar="N", help="quiz poll; N = 0-based index of the correct option")
    s.add_argument("--public", action="store_true", help="non-anonymous poll (default: anonymous)")
    s.add_argument("--dry-run", dest="dry_run", action="store_true")

    s = sub.add_parser("react"); s.add_argument("msg_id"); s.add_argument("emoji", nargs="?"); add_to(s)
    s = sub.add_parser("reactions"); add_to(s)
    s = sub.add_parser("delete"); s.add_argument("msg_id"); add_to(s)

    s = sub.add_parser("ack"); add_to(s)
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")

    s = sub.add_parser("topics"); s.add_argument("sub", nargs="?"); s.add_argument("args", nargs="*")
    return p


def main():
    a = build_parser().parse_args()
    ctx = Ctx()
    globals()["cmd_%s" % a.cmd](ctx, a)


if __name__ == "__main__":
    main()
