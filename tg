def cmd_delete(ctx, a):
    to = ctx.resolve_chat(a.to or "group")
    if not to:
        die("delete: no target chat", 2)
    j = api_post(ctx, "deleteMessage", {"chat_id": to, "message_id": a.msg_id})
    row = {"kind": "deleted", "direction": "out", "chat": {"id": int(to)},
           "ref_message_id": int(a.msg_id), "date": int(time.time()), "api_response": j}
    with open(ctx.hist, "a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")
    print("ok" if j.get("ok") else "err: %s" % j.get("description"))


def cmd_media(ctx, _a):
    fetch_media(ctx)


def cmd_ids(ctx, _a):
    if not os.path.exists(ctx.hist):
        print("no history yet — poll first"); return
    seen = {}
    with open(ctx.hist, encoding="utf-8") as f:
        for line in f:
            try:
                r = json.loads(line)
            except Exception:
                continue
            if r.get("direction") != "in":
                continue
            c = r.get("chat") or {}
            if c.get("id") is None:
                continue
            nm = (r.get("from") or {}).get("first_name") or "?"
            seen.setdefault((c.get("id"), c.get("type")), set()).add(nm)
    for (cid, ctype), names in sorted(seen.items()):
        print("%15s  %-10s  %s" % (cid, ctype, ", ".join(sorted(names))))


def cmd_topics(ctx, a):
    sub = a.sub or "list"
    if sub == "list":
        m = topics_load(ctx.topics)
        if not m:
            print("(no topics cached yet — appear when the poller sees forum_topic_created,"
                  " or add via: tg topics set <name> <thread_id>)")
            return
        for k, v in sorted(m.items(), key=lambda kv: kv[1]):
            print("  #%-24s %s" % (k, v))
    elif sub == "resolve":
        tid = topics_resolve(ctx.topics, a.args[0])
        if tid is None:
            sys.exit(3)
        print(tid)
    elif sub == "set":
        norm = topics_upsert(ctx.topics, int(a.args[1]), a.args[0])
        print("topics: #%s → %s" % (norm, a.args[1]))
    elif sub == "rm":
        m = topics_load(ctx.topics)
        norm = topic_normalize(a.args[0])
        if norm not in m:
            die("no topic '%s' cached" % norm)
        del m[norm]; topics_save(ctx.topics, m)
        print("topics: removed #%s" % norm)
    else:
        die("unknown topics subcommand: %s" % sub, 2)


def _which(prog):
    return any(os.access(os.path.join(p, prog), os.X_OK)
               for p in os.environ.get("PATH", "").split(os.pathsep))


# ── CLI ───────────────────────────────────────────────────────────────────────

def build_parser():
    import argparse
    p = argparse.ArgumentParser(prog="tg", description="global Telegram bot CLI (repo-local state)")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("poll"); sub.add_parser("doctor"); sub.add_parser("watch")
    sub.add_parser("media"); sub.add_parser("ids")

    s = sub.add_parser("send"); s.add_argument("text")
    s.add_argument("--to"); s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")
    s.add_argument("--html", action="store_true"); s.add_argument("--dry-run", dest="dry_run", action="store_true")

    s = sub.add_parser("sendvoice"); s.add_argument("text"); s.add_argument("to", nargs="?")

    s = sub.add_parser("senddoc"); s.add_argument("path")
    s.add_argument("--to"); s.add_argument("--caption"); s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")

    s = sub.add_parser("react"); s.add_argument("msg_id"); s.add_argument("emoji", nargs="?"); s.add_argument("--to")
    s = sub.add_parser("delete"); s.add_argument("msg_id"); s.add_argument("--to")

    s = sub.add_parser("topics"); s.add_argument("sub", nargs="?"); s.add_argument("args", nargs="*")
    return p


def main():
    a = build_parser().parse_args()
    ctx = Ctx()
    globals()["cmd_%s" % a.cmd](ctx, a)


if __name__ == "__main__":
    main()
