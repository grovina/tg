def cmd_show(ctx, a):
    """Print the FULL stored record for a message: complete text untruncated, plus
    sender / chat / thread / date and any media or voice transcript. `tg watch`
    lines clip long messages (and the Monitor surfacing them clips further) — this
    recovers the whole thing without hand-grepping history.jsonl.

    Takes a qualified ref (`GROUP:1746`) or a bare id. Where a write command
    refuses an ambiguous bare id, `show` prints EVERY message carrying it, each
    under its own header with its own transcript attached. Reading is safe to
    disambiguate by showing more; the failure being fixed was one message's header
    printed above another's transcript, which looked entirely coherent and was
    wrong. Two clearly separated records can't do that."""
    rows = load_rows(ctx)
    if not rows:
        print("no history yet — poll first"); return
    chat_spec, mid = parse_ref(a.msg_id, "show")
    legacy = first_arrival(rows)
    tr = {}
    for r in rows:
        if r.get("kind") == "transcript":
            k = transcript_key(r, legacy)
            if k:
                tr.setdefault(k, []).append(r)
    hits = sorted((r for (_c, m), r in inbound_messages(rows).items() if m == mid),
                  key=lambda r: r.get("date") or 0)
    if chat_spec is not None:
        want = int(ctx.resolve_chat(chat_spec))
        hits = [r for r in hits if (r.get("chat") or {}).get("id") == want]
    if not hits:
        orphans = [t for (_c, m), ts in tr.items() if m == mid for t in ts]
        print("no inbound message #%s in history%s" % (
            mid, " (voice transcript only — below)" if orphans else ""))
        for t in orphans:
            _print_transcript(t)
        return
    if len(hits) > 1:
        print("⚠ %d different messages carry id #%s (message ids are per-chat). "
              "Showing all; name one with its ref to see it alone.\n" % (len(hits), mid))
    for i, r in enumerate(hits):
        if i:
            print("\n" + "─" * 64 + "\n")
        _show_message(ctx, r, tr.get(((r.get("chat") or {}).get("id"), mid), []))


# How far back we look for polls. A poll has no "closed" state we can see, so
# without a horizon the list would grow without bound on a box that sends a
# checklist every morning.
POLL_REVIEW_DAYS = 7


def scan_polls(ctx, days=POLL_REVIEW_DAYS):
    """Polls WE sent inside the window, each with its votes and its review state.
    Returns [(sent, poll_id, out_row, votes, fresh, reviewed)] oldest-first, where
    `votes` is {voter_id: (date, name, option_ids)} with the LATEST answer per voter
    winning (Telegram REPLACES a voter's selection on every change; an empty list is
    a retraction), and `fresh` counts the voters whose latest answer landed after our
    last `tg pollstatus` of that poll.

    Poll rows are keyed by poll_id, never by chat: a `poll_answer` update carries no
    chat at all. That is the whole reason votes need their own accounting instead of
    riding the chat-keyed message watermark."""
    polls, votes, reviewed = {}, {}, {}
    if not os.path.exists(ctx.hist):
        return []
    with open(ctx.hist, encoding="utf-8") as f:
        for line in f:
            try:
                r = json.loads(line)
            except Exception:
                continue
            d = r.get("date")
            if d is None:
                continue
            kind = r.get("kind")
            if kind == "poll_answer" and r.get("poll_id"):
                vid = (r.get("from") or {}).get("id")
                if vid is None:
                    continue
                cur = votes.setdefault(r["poll_id"], {})
                if vid not in cur or d >= cur[vid][0]:
                    cur[vid] = (d, (r.get("from") or {}).get("first_name") or "?",
                                r.get("option_ids") or [])
            elif kind == "poll_seen" and r.get("poll_id"):
                reviewed[r["poll_id"]] = max(d, reviewed.get(r["poll_id"], -1))
            elif r.get("direction") == "out" and r.get("poll"):
                p = r["poll"]
                if p.get("poll_id"):
                    polls[p["poll_id"]] = (d, r)      # a re-send of the same poll: latest wins
    horizon = time.time() - days * 86400
    out = []
    for pid, (sent, r) in polls.items():
        if sent < horizon:
            continue
        wm = reviewed.get(pid, -1)                    # -1 = never reviewed
        v = votes.get(pid, {})
        fresh = sum(1 for (d, _n, _o) in v.values() if d > wm)
        out.append((sent, pid, r, v, fresh, wm >= 0))
    return sorted(out)


def _poll_line(ctx, r, v):
    """One poll, rendered: where it went, its question, and the state of the tally."""
    p = r["poll"]
    options = p.get("options") or []
    picked = {oi for (_d, _n, opts) in v.values() for oi in opts}
    unchecked = [i for i in range(len(options)) if i not in picked]
    voters = sum(1 for (_d, _n, opts) in v.values() if opts)   # a retracted vote isn't a voter
    cid = (r.get("chat") or {}).get("id")
    alias = ctx.chat_alias(cid)
    loc = (alias + " " if alias else "") + str(cid)
    head = "  #%-7s [%s] %s" % (r.get("message_id"), loc,
                                (r.get("text") or "").replace("\n", " ")[:52])
    if not voters:
        return head, "    nobody has voted"
    last = max(d for (d, _n, _o) in v.values())
    return head, "    %d voter%s, %d/%d option%s unchecked, last vote %s" % (
        voters, "" if voters == 1 else "s", len(unchecked), len(options),
        "" if len(unchecked) == 1 else "s", _iso(last))


def cmd_polls(ctx, a):
    """Every poll WE sent in the last week (`--days N` to widen), with its tally:
    how many voted, how many options nobody has ticked, when the last vote landed.
    The standing view — "how are the checklists doing?" — as opposed to `tg pending`,
    which only reports the votes you have NOT yet looked at. Read-only: listing a
    poll does not mark it reviewed (only `tg pollstatus` does).

    A poll with no votes is listed here but never in `pending`: nothing arrived, so
    nothing can have been missed. An empty checklist is a shop-discipline question,
    not a lost message."""
    rows = scan_polls(ctx, a.days)
    if not rows:
        print("no polls sent in the last %d days" % a.days); return
    print("%d poll(s) in the last %d days:" % (len(rows), a.days))
    for _sent, _pid, r, v, fresh, was_reviewed in rows:
        head, tally = _poll_line(ctx, r, v)
        mark = "  ✳ %d unreviewed vote%s" % (fresh, "" if fresh == 1 else "s") if fresh else ""
        if r["poll"].get("anonymous"):
            mark += "  (anonymous — no voters visible)"
        print(head)
        print("%s%s" % (tally, mark))
    print("→ `tg pollstatus <#id>` for the per-option tally (who ticked what)")


def _reconcile_state(rows):
    """Per-(chat, thread) watermarks: newest inbound, newest outbound, newest ack.

    Shared by `pending` and `ack` so the two can never disagree about what is still
    owed — they used to compute it separately, which is exactly how `ack` came to
    report success on a chat while `pending` kept showing its threads."""
    last_in, last_out, last_ack, who, msgs = {}, {}, {}, {}, {}
    for r in rows:
        d = r.get("date")
        if d is None:                       # undated rows (failed sends, deletes) carry no ordering
            continue
        cid = (r.get("chat") or {}).get("id")
        if cid is None:
            continue
        key = (cid, r.get("thread_id"))
        if is_message(r):                   # real inbound message only
            if d >= last_in.get(key, -1):
                last_in[key] = d
                who[key] = (r.get("from") or {}).get("first_name") or "?"
            msgs.setdefault(key, []).append((d, _preview(r, 100), r.get("message_id")))
        elif r.get("direction") == "out":
            last_out[key] = max(d, last_out.get(key, -1))
        elif r.get("kind") == "ack":         # seen, no reply needed — clears like a reply
            last_ack[key] = max(d, last_ack.get(key, -1))
    return {"last_in": last_in, "last_out": last_out, "last_ack": last_ack,
            "who": who, "msgs": msgs}


def _seen(st, key):
    """Watermark for a (chat, thread): replied-to OR acked, whichever is later."""
    return max(st["last_out"].get(key, -1), st["last_ack"].get(key, -1))


def _open_keys(st, cid=None):
    """(chat, thread) pairs still holding unanswered inbound, optionally one chat."""
    return sorted(k for k, din in st["last_in"].items()
                  if din > _seen(st, k) and (cid is None or k[0] == cid))


def cmd_pending(ctx, _a):
    """Everything still owed your attention — the reconcile backstop a session runs
    after (re-)arming `tg watch`, to catch what landed while the live Monitor was
    down. A pure read of history.jsonl. Two sections:

    MESSAGES — chats (and forum threads) whose latest inbound message is newer than
    our latest reply OR ack there. An `ack` clears a chat without a reply (seen,
    nothing to answer), so chatter/FYIs you won't answer don't linger forever;
    reactions / membership / meta rows don't count as messages to answer; forum
    topics are keyed per-thread so a reply in one thread doesn't mask an unanswered
    message in another.

    POLLS — polls WE sent that have votes we have NOT looked at. A vote is not a
    message: `poll_answer` carries no chat and no text, so the reply/ack watermark
    above can never reach it, and a vote that lands while the Monitor is down is
    otherwise invisible on EVERY surface — which is the whole reason this section
    exists. `tg pollstatus <id>` is the review, and doing it marks the poll seen; a
    vote arriving afterwards re-surfaces it.

    A poll with NO votes is deliberately absent: nothing arrived, so nothing can
    have been missed, and a shop that sends four checklists a morning would bury the
    real signal under empty ones. `tg polls` is the standing view that shows those.
    Anonymous polls never appear either — Telegram reveals no voters, so there is
    nothing to reconcile."""
    if not os.path.exists(ctx.hist):
        print("no history yet — poll first"); return
    st = _reconcile_state(load_rows(ctx))
    last_in, who, msgs = st["last_in"], st["who"], st["msgs"]

    def seen(key):
        return _seen(st, key)
    rows = [(din, key) for key, din in last_in.items() if din > seen(key)]
    # Only polls with votes we haven't reviewed: those are the ones a dropped Monitor
    # could have swallowed. No votes ⇒ nothing was missed ⇒ not pending (see `tg polls`).
    open_polls = [t for t in scan_polls(ctx)
                  if t[4] and not t[2]["poll"].get("anonymous")]

    if not rows and not open_polls:
        print("all caught up — no unanswered inbound, no unreviewed poll votes"); return

    for din, key in sorted(rows):
        cid, tid = key
        wm = seen(key)
        unanswered = [(mid, t) for (dd, t, mid) in sorted(msgs.get(key, [])) if dd > wm]
        iso = datetime.datetime.fromtimestamp(din, datetime.UTC).isoformat()
        alias = ctx.chat_alias(cid)
        loc = (alias + " " if alias else "") + str(cid) + ("" if tid is None else " thread %s" % tid)
        print("%-30s %-12s %d unanswered, last %s" % (loc, who.get(key, "?"), len(unanswered), iso))
        for mid, t in unanswered[-3:]:
            print("    %-24s %s" % (ref_str(ctx, cid, mid), t.replace("\n", " ")[:100]))
    if rows:
        print("→ `tg reply <ref> <text>` to answer in place, or `tg ack <chat>%s` for "
              "anything that needs no answer" % (" --topic-id <n>" if any(t is not None for _d, (_c, t) in rows) else ""))

    if not open_polls:
        return
    if rows:
        print()
    print("polls with unreviewed votes (%d):" % len(open_polls))
    for _sent, _pid, r, v, fresh, was_reviewed in open_polls:
        head, tally = _poll_line(ctx, r, v)
        print(head)
        print("%s  ← %d unreviewed%s" % (tally, fresh, "" if was_reviewed else ", never reviewed"))
    print("→ `tg pollstatus <#id>` for the per-option tally — reviewing it marks it seen")


def cmd_ack(ctx, a):
    """Mark a chat/thread as SEEN — acknowledged, no reply needed — so it stops
    showing in `tg pending`. Sets a watermark at the latest inbound timestamp there
    at ack time; anything that arrives later re-surfaces. Lets you clear chatter /
    FYIs / thanks you legitimately won't answer without sending a reply. Silent —
    writes only a local history row; to acknowledge VISIBLY to the sender, react
    instead (`tg react`).

    A forum thread is its own reconcile scope, so `tg ack <chat>` clears the chat's
    main timeline and NOT its topics — correct, but previously indistinguishable
    from a broken tool: ack printed success while `pending` kept showing the thread,
    and the natural reading is "ack doesn't work". So an ack that leaves anything
    open in the same chat now says so, and names the command that finishes the job.
    `--all-threads` does the whole chat in one go."""
    to = ctx.resolve_chat(_to(a))
    cid = int(to)
    if a.all_threads and (a.topic or a.topic_id):
        die("ack: --all-threads already covers every thread — drop the --topic/--topic-id", 2)
    thread = _thread_for(ctx, a.topic, a.topic_id)
    tid = int(thread) if thread else None
    st = _reconcile_state(load_rows(ctx))
    targets = [k for k in _open_keys(st, cid)] if a.all_threads else [(cid, tid)]
    if a.all_threads and not targets:
        print("ack: nothing open in %s" % (ctx.chat_alias(cid) or cid)); return
    acked = []
    label = "%s %s" % (ctx.chat_alias(cid), to) if ctx.chat_alias(cid) else str(to)
    for key in targets:
        latest = st["last_in"].get(key)
        loc = "%s%s" % (label, "" if key[1] is None else " thread %s" % key[1])
        if latest is None:
            print("ack: nothing inbound to ack in %s" % loc)
            continue
        row = {"kind": "ack", "direction": "meta", "chat": {"id": cid}, "thread_id": key[1],
               "date": latest, "iso": datetime.datetime.fromtimestamp(latest, datetime.UTC).isoformat()}
        with open(ctx.hist, "a", encoding="utf-8") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
        st["last_ack"][key] = max(latest, st["last_ack"].get(key, -1))
        acked.append(key)
        print("ack: %s — seen through %s" % (loc, row["iso"]))
    if not acked:
        return
    still = [k for k in _open_keys(st, cid) if k not in acked]
    if still:
        print("  ⚠ still unanswered in this chat (ack is per-thread):")
        for _c, t in still:
            print("      %s%s" % (label,
                                  " thread %s — `tg ack %s --topic-id %s`" % (t, to, t)
                                  if t is not None else " (main timeline) — `tg ack %s`" % to))
        print("      or clear them all: `tg ack %s --all-threads`" % to)


def cmd_topics(ctx, a):
    sub = a.sub or "list"
    if sub == "list":
        m = topics_load(ctx.topics)
        if not m:
            print("(no topics cached yet — appear when the poller sees forum_topic_created,"
                  " or add via: tg topics set <name> <thread_id>)")
            return
        for k, v in sorted(m.items(), key=lambda kv: kv[1]):
            print("  #%-24s %s" % (k, v))
    elif sub == "resolve":
        tid = topics_resolve(ctx.topics, a.args[0])
        if tid is None:
            sys.exit(3)
        print(tid)
    elif sub == "set":
        norm = topics_upsert(ctx.topics, int(a.args[1]), a.args[0])
        print("topics: #%s → %s" % (norm, a.args[1]))
    elif sub == "rm":
        m = topics_load(ctx.topics)
        norm = topic_normalize(a.args[0])
        if norm not in m:
            die("no topic '%s' cached" % norm)
        del m[norm]; topics_save(ctx.topics, m)
        print("topics: removed #%s" % norm)
    else:
        die("unknown topics subcommand: %s" % sub, 2)


def _which(prog):
    return any(os.access(os.path.join(p, prog), os.X_OK)
               for p in os.environ.get("PATH", "").split(os.pathsep))


# ── CLI ───────────────────────────────────────────────────────────────────────

def build_parser():
    import argparse
    p = argparse.ArgumentParser(prog="tg", description="global Telegram bot CLI (repo-local state)")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("poll"); sub.add_parser("doctor"); sub.add_parser("watch")
    sub.add_parser("media"); sub.add_parser("ids"); sub.add_parser("pending")
    s = sub.add_parser("migrate")
    s.add_argument("--dry-run", dest="dry_run", action="store_true",
                   help="print what would move, change nothing")
    s = sub.add_parser("show")
    s.add_argument("msg_id", metavar="REF",
                   help="message ref: GROUP:1746 (qualified) or 1746 (bare; shows every "
                        "chat's message with that id)")

    # The target chat is a REQUIRED LEADING positional on every send command: the
    # recipient comes first (like every messaging tool), and the free-form message
    # goes last where a broken shell quote can't swallow it. There is no group
    # default — _to() errors on omission. `--to` is an order-independent alternative.
    def add_target(s):
        s.add_argument("to", nargs="?",
                       help="target chat (required): `group`/`team`, a tg.conf alias, or a numeric id")
        s.add_argument("--to", dest="to_flag", metavar="CHAT",
                       help="target chat as a flag (alternative to the leading positional)")

    s = sub.add_parser("send"); add_target(s); s.add_argument("text", nargs="?")
    s.add_argument("--file", dest="text_file", help="read the message text from FILE (avoids shell-quoting traps)")
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")
    s.add_argument("--html", action="store_true"); s.add_argument("--dry-run", dest="dry_run", action="store_true")

    # reply targets the chat of the message it answers — no [to], by design.
    s = sub.add_parser("reply")
    s.add_argument("msg_id", metavar="REF",
                   help="message ref from watch/pending: GROUP:1746, or a bare 1746 when "
                        "only one chat has it (ambiguous ⇒ refused, never guessed)")
    s.add_argument("text", nargs="?")
    s.add_argument("--file", dest="text_file", help="read the reply text from FILE (avoids shell-quoting traps)")
    s.add_argument("--html", action="store_true")

    s = sub.add_parser("sendvoice"); add_target(s); s.add_argument("text")

    s = sub.add_parser("senddoc"); add_target(s); s.add_argument("path")
    s.add_argument("--caption"); s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")

    s = sub.add_parser("sendphoto"); add_target(s); s.add_argument("path")
    s.add_argument("--caption"); s.add_argument("--html", action="store_true")
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")

    # Options are variadic, so the target can't be a leading positional here — it
    # comes from --to (now required, like everywhere: no group default).
    s = sub.add_parser("sendpoll"); s.add_argument("question"); s.add_argument("options", nargs="+")
    s.add_argument("--to", dest="to_flag", metavar="CHAT",
                   help="target chat (required): `group`/`team`, a tg.conf alias, or a numeric id")
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")
    s.add_argument("--multi", action="store_true", help="allow multiple answers (regular poll)")
    s.add_argument("--quiz", type=int, metavar="N", help="quiz poll; N = 0-based index of the correct option")
    s.add_argument("--public", action="store_true", help="non-anonymous poll (default: anonymous)")
    s.add_argument("--dry-run", dest="dry_run", action="store_true")

    s = sub.add_parser("pollstatus")
    s.add_argument("msg_id", nargs="?", metavar="REF",
                   help="the poll's message ref (GROUP:4567 or a bare 4567; omit for the most recent)")
    s.add_argument("--poll-id", dest="poll_id", help="target by Telegram poll_id instead of message id")

    s = sub.add_parser("polls")
    s.add_argument("--days", type=int, default=POLL_REVIEW_DAYS, metavar="N",
                   help="how far back to look (default: %d)" % POLL_REVIEW_DAYS)

    # react / delete are message-id-primary: the chat is resolved from history by
    # msg_id (like reply), so no positional target — --to only overrides it.
    s = sub.add_parser("react"); s.add_argument("msg_id", metavar="REF")
    s.add_argument("emoji", nargs="?")
    s.add_argument("--to", dest="to_flag", metavar="CHAT",
                   help="override target chat (default: the message's chat, from history)")
    s = sub.add_parser("reactions"); add_target(s)
    s = sub.add_parser("delete"); s.add_argument("msg_id", metavar="REF")
    s.add_argument("--to", dest="to_flag", metavar="CHAT",
                   help="override target chat (default: the message's chat, from history)")

    s = sub.add_parser("ack"); add_target(s)
    s.add_argument("--topic"); s.add_argument("--topic-id", dest="topic_id")
    s.add_argument("--all-threads", dest="all_threads", action="store_true",
                   help="ack every open thread in the chat, not just one scope")

    s = sub.add_parser("topics"); s.add_argument("sub", nargs="?"); s.add_argument("args", nargs="*")
    return p


def main():
    a = build_parser().parse_args()
    ctx = Ctx()
    globals()["cmd_%s" % a.cmd](ctx, a)


if __name__ == "__main__":
    main()
