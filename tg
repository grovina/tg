#!/usr/bin/env python3
"""tg — a global Telegram bot CLI, like `gh`/`gcloud`: one binary, repo-local state.

Consolidates a bash + python Telegram toolkit that had been copy-pasted (and
drifted) across several repos into a single stdlib-only Python CLI. Transport is
the Telegram Bot API getUpdates long-poll (the only transport any of them used).
The *code* is shared and global; the *state* and *config* are per-repo, resolved
from the repo you're standing in:

  state   <repo>/var/telegram/   history.jsonl · offset · poller.pid · poller.beat · media/<chat_id>/ · topics.json
  config  <repo>/tg.conf         GROUP=... + UPPERCASE chat aliases + TG_TRANSCRIBE_* (optional)
          env / .env             secrets: TG_BOT_TOKEN, TG_ELEVENLABS_KEY (optional)

A MESSAGE IS IDENTIFIED BY (chat_id, message_id), never by the id alone — a
Telegram message_id is unique only within its chat, so #1746 in the group and
#1746 in a DM are different messages. Refs are written `<chat>:<id>` —
`GROUP:1746`, `-1004412570945:1746` — and that is what every surface prints. A
bare `1746` still works and is resolved: unique ⇒ fine, ambiguous ⇒ writes
(reply/react/delete) REFUSE and list the candidates, while `show` prints them
all. Media lives at `media/<chat_id>/<msg_id>.<ext>` for the same reason; `tg
migrate` moves a pre-2026-07-28 repo into that layout.

Audio is always downloaded; transcription (ElevenLabs Scribe) is layered on top
only when TG_ELEVENLABS_KEY is present. Language auto-detects unless
TG_TRANSCRIBE_LANG forces one — globally, or per chat as
TG_TRANSCRIBE_LANG_<ALIAS> — so a multilingual group (de/en/pt-BR) just works
while a one-language DM can be pinned. Transcripts carry the engine's own
language + confidence, and are FLAGGED (never dropped) when the detected
language or writing system can't be right for the chat — declare what a chat
can plausibly be with TG_TRANSCRIBE_EXPECT=fr,pt,en.

history.jsonl is an append-only in+out conversation log with a stable schema (safe to tail).

Commands:
  poll                       long-poll daemon (pid-guarded singleton, idempotent)
  doctor                     (re)start the poller detached if dead
  watch                      doctor + watchdog + follow history.jsonl -> Monitor stream
  send <to> <text|--file F>  sendMessage   (+ --topic <name>|--topic-id <n> --html --dry-run)
  reply <ref> <text|--file F>  reply IN the originating chat (resolved from history) + thread it (+ --html)
  show <ref>                 the full stored record of a message (text, media, transcript)
  sendvoice <to> <text>      ElevenLabs TTS -> opus -> sendVoice
  senddoc <to> <path>        sendDocument — file attachment (+ --caption --topic …)
  sendphoto <to> <path>      sendPhoto — inline image    (+ --caption --html --topic …)
  sendpoll <q> <opt…>        sendPoll — question + 2-10 options (--quiz N --multi --public --topic …; target via --to)
  polls [--days N]           every poll we sent lately + its tally (incl. the ones nobody voted on)
  pollstatus [msg_id]        per-option tally of a poll WE sent: who voted each option + which options nobody picked (needs --public); marks it reviewed
  react <ref> [emoji]        setMessageReaction (empty emoji clears; chat from the ref/history, --to overrides)
  reactions <to>             list the emoji this chat actually allows as reactions
  delete <ref>               deleteMessage + synthetic 'deleted' history row (chat from the ref/history, --to overrides)

The target chat <to> is a REQUIRED LEADING positional on every send command — the
recipient comes first (like every messaging tool), and the free-form message goes
last where a broken shell quote can't swallow it. There is NO group default:
omitting the target is a hard error, never a silent broadcast to the group (that's
how a private DM once leaked to the whole staff group). Reach the group explicitly
with `group`/`team`, an alias, or its id; `--to` is an order-independent alternative.
reply/react/delete take no target — they resolve the chat from the message id in
history (react/delete accept --to to override).

`watch`/`pending` name each inbound channel by IDENTITY and carry its chat_id —
"MSG [BACKOFFICE -5470784074] Jerome #BACKOFFICE:156: …" — so two same-type chats
never collide and a reply targets the right one mechanically: `tg reply
BACKOFFICE:156 <text>` (by the ref) or `tg send -5470784074 <text>` (by the
chat_id). Never infer a target from a type word.
  media                      idempotent backfill: download media + Scribe-transcribe
  migrate                    move legacy media/<msg_id>.<ext> -> media/<chat_id>/<msg_id>.<ext> (--dry-run)
  ids                        print chat ids seen in history
  pending                    the reconcile backstop — chats/threads with inbound newer than your last
                             reply or ack, PLUS polls whose votes you haven't reviewed. Votes are not
                             messages (no chat, no text), so nothing else can surface one that landed
                             while the Monitor was down. Run it after (re-)arming `tg watch`. Polls
                             with NO votes are `tg polls`' business, not pending's — nothing arrived,
                             so nothing was missed.
  ack <to> [--topic-id N|--all-threads]  mark a chat/thread SEEN (no reply needed) so it drops from `pending`
  topics [list|set <name> <id>|rm <name>|resolve <name>]
"""
import sys, os, json, re, time, uuid, signal, datetime, mimetypes, subprocess, filecmp
import socket, threading, http.client
import urllib.request, urllib.parse


# ── repo resolution + config ──────────────────────────────────────────────────

def find_root():
    """Walk up from cwd to the repo root (marker: tg.conf, var/telegram, or .git)."""
    d = os.getcwd()
    while True:
        for marker in ("tg.conf", os.path.join("var", "telegram"), ".git"):
            if os.path.exists(os.path.join(d, marker)):
                return d
        parent = os.path.dirname(d)
        if parent == d:
            return os.getcwd()
        d = parent


def _load_kv(path, into):
    """Merge KEY=VALUE lines (dotenv-style) into a dict."""
    if not os.path.exists(path):
        return
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            into[k.strip()] = v.strip().strip('"\'')


class Ctx:
    """Resolved per-repo context: paths, config, token, API bases."""
    def __init__(self):
        self.root = find_root()
        self.var = os.path.join(self.root, "var", "telegram")
        os.makedirs(os.path.join(self.var, "media"), exist_ok=True)
        self.hist = os.path.join(self.var, "history.jsonl")
        self.off = os.path.join(self.var, "offset")
        self.pid = os.path.join(self.var, "poller.pid")
        self.beat = os.path.join(self.var, "poller.beat")
        self.plog = os.path.join(self.var, "poll.log")
        self.media = os.path.join(self.var, "media")
        self.topics = os.path.join(self.var, "topics.json")

        cfg = {}
        _load_kv(os.path.join(self.root, "tg.conf"), cfg)       # non-secret config
        _load_kv(os.path.join(self.root, ".env"), cfg)          # local secrets
        cfg.update(os.environ)                                  # env wins
        self.cfg = cfg

        self.token = cfg.get("TG_BOT_TOKEN") or _read(os.path.join(self.var, "token"))
        if not self.token:
            die("no bot token (set TG_BOT_TOKEN, or write %s, or TG_BOT_TOKEN= in tg.conf)"
                % os.path.join(self.var, "token"))
        self.api = "https://api.telegram.org/bot%s" % self.token
        self.filebase = "https://api.telegram.org/file/bot%s" % self.token

        # Reverse of the chat registry: chat_id -> symbolic alias, so inbound
        # events can name their channel by IDENTITY (GROUP / BACKOFFICE / a DM
        # name…) instead of an ambiguous Telegram type. Built from the same
        # UPPERCASE alias=chat_id pairs resolve_chat() reads; a value must look
        # like a chat id (≥5 digits, optional sign) so ordinary env vars don't
        # masquerade as channels. First alias for an id wins (tg.conf is merged
        # before .env / environ).
        self.chat_names = {}
        for k, v in cfg.items():
            if k.startswith("TG_") or not re.fullmatch(r"[A-Z][A-Z0-9_]*", k):
                continue
            if re.fullmatch(r"-?\d{5,}", str(v)):
                self.chat_names.setdefault(str(v), k)

    def get(self, key, default=None):
        return self.cfg.get(key, default)

    def chat_alias(self, cid):
        """Symbolic name for a chat_id (the inverse of resolve_chat), or None."""
        return self.chat_names.get(str(cid)) if cid is not None else None

    def resolve_chat(self, name):
        """Symbolic name -> chat_id. 'group'/'team' -> GROUP; a numeric id passes
        through; an UPPERCASE alias must be defined in tg.conf. An unknown alias or
        a missing GROUP is a HARD ERROR — never a silent group fallback (that's how
        a DM meant for one person ends up broadcast to the whole staff group). The
        empty/omitted case is refused upstream in _to(): there is no group default,
        so the group must be named explicitly ('group'/'team', an alias, or its id)."""
        n = (name or "").strip()
        if n in ("group", "team"):
            g = self.cfg.get("GROUP", "")
            if not g:
                die("no GROUP configured — set GROUP=<chat_id> in tg.conf", 2)
            return g
        if re.fullmatch(r"-?\d+", n):
            return n
        cid = self.cfg.get(n.upper(), "")
        if not cid:
            known = ", ".join(sorted(set(self.chat_names.values()))) or "(none)"
            die("unknown target chat %r — known aliases: %s. Pass a numeric chat_id, a "
                "defined alias, or `group`/`team` for the group." % (name, known), 2)
        return cid


def _read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def die(msg, code=1):
    sys.stderr.write("tg: %s\n" % msg)
    sys.exit(code)


# ── HTTP (Telegram Bot API) ─────────────────────────────────────────────────

def _http(url, data=None, headers=None, timeout=60, method=None, opener=None):
    req = urllib.request.Request(url, data=data, method=method)
    for k, v in (headers or {}).items():
        req.add_header(k, v)
    _open = opener.open if opener else urllib.request.urlopen
    with _open(req, timeout=timeout) as r:
        return r.read()


class _KeepAliveHTTPSConnection(http.client.HTTPSConnection):
    """HTTPS connection with TCP keepalive — so a long-poll socket stranded by a
    silently-dropped connection (e.g. NAT/conntrack eviction across a container
    suspend/resume) is reset by the kernel in ~35s instead of blocking forever."""
    def connect(self):
        super().connect()
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        for opt, val in (("TCP_KEEPIDLE", 20), ("TCP_KEEPINTVL", 5), ("TCP_KEEPCNT", 3)):
            o = getattr(socket, opt, None)
            if o is not None:
                self.sock.setsockopt(socket.IPPROTO_TCP, o, val)


class _KeepAliveHTTPSHandler(urllib.request.HTTPSHandler):
    def https_open(self, req):
        return self.do_open(_KeepAliveHTTPSConnection, req)


_KEEPALIVE_OPENER = urllib.request.build_opener(_KeepAliveHTTPSHandler())


def api_get(ctx, method, params=None, timeout=60):
    url = "%s/%s" % (ctx.api, method)
    if params:
        url += "?" + urllib.parse.urlencode(params)
    return json.loads(_http(url, timeout=timeout))


def api_post(ctx, method, fields, timeout=60):
    body = urllib.parse.urlencode(fields).encode()
    return json.loads(_http("%s/%s" % (ctx.api, method), data=body,
                            headers={"Content-Type": "application/x-www-form-urlencoded"},
                            timeout=timeout, method="POST"))


def _multipart(fields, files):
    """files: {name: (filename, bytes, content_type)}."""
    boundary = "----tg%s" % uuid.uuid4().hex
    crlf = b"\r\n"
    buf = []
    for k, v in fields.items():
        buf += [b"--" + boundary.encode(), crlf,
                ('Content-Disposition: form-data; name="%s"' % k).encode(),
                crlf, crlf, str(v).encode(), crlf]
    for name, (fname, data, ctype) in files.items():
        buf += [b"--" + boundary.encode(), crlf,
                ('Content-Disposition: form-data; name="%s"; filename="%s"'
                 % (name, fname)).encode(), crlf,
                ("Content-Type: %s" % ctype).encode(), crlf, crlf, data, crlf]
    buf += [b"--" + boundary.encode() + b"--", crlf]
    return boundary, b"".join(buf)


def api_post_multipart(ctx, method, fields, files, timeout=120):
    boundary, body = _multipart(fields, files)
    return json.loads(_http(
        "%s/%s" % (ctx.api, method), data=body,
        headers={"Content-Type": "multipart/form-data; boundary=%s" % boundary},
        timeout=timeout, method="POST"))


# ── topics registry (name <-> thread_id) ─────────────────────────────────────

def topic_normalize(name):
    n = re.sub(r"[^a-z0-9]+", "-", name.strip().lower()).strip("-")
    return n or name.strip().lower()


def topics_load(path):
    try:
        with open(path, encoding="utf-8") as f:
            return {str(k): int(v) for k, v in json.load(f).items()}
    except (FileNotFoundError, ValueError):
        return {}


def topics_save(path, data):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2, sort_keys=True)
        f.write("\n")


def topics_upsert(path, thread_id, raw_name):
    m = topics_load(path)
    name = topic_normalize(raw_name)
    for k, v in list(m.items()):
        if v == thread_id and k != name:
            del m[k]
    m[name] = int(thread_id)
    topics_save(path, m)
    return name


def topics_resolve(path, raw_name):
    return topics_load(path).get(topic_normalize(raw_name))


# ── ingest (getUpdates body -> history rows + offset) ─────────────────────────

def extract_media(m):
    if m.get("photo"):
        p = max(m["photo"], key=lambda x: x.get("file_size") or x.get("width") or 0)
        return {"type": "photo", "file_id": p.get("file_id"),
                "file_unique_id": p.get("file_unique_id"), "mime": "image/jpeg",
                "duration": None, "file_size": p.get("file_size"), "file_name": None}
    for kind in ("voice", "audio", "video_note", "video", "animation", "document", "sticker"):
        o = m.get(kind)
        if o:
            return {"type": kind, "file_id": o.get("file_id"),
                    "file_unique_id": o.get("file_unique_id"), "mime": o.get("mime_type"),
                    "duration": o.get("duration"), "file_size": o.get("file_size"),
                    "file_name": o.get("file_name")}
    return None


_SKIP = {"message_id", "from", "sender_chat", "chat", "date", "text", "caption",
         "caption_entities", "entities", "edit_date", "reply_to_message",
         "forward_origin", "forward_from", "forward_from_chat",
         "forward_from_message_id", "forward_signature", "forward_sender_name",
         "forward_date", "media_group_id", "author_signature", "via_bot",
         "is_automatic_forward", "has_protected_content", "is_topic_message",
         "message_thread_id", "forum_topic_created", "forum_topic_edited",
         "forum_topic_closed", "forum_topic_reopened"}


def _iso(ts):
    return datetime.datetime.fromtimestamp(ts, datetime.UTC).isoformat() if ts else None


def _who(d):
    d = d or {}
    return {"id": d.get("id"), "first_name": d.get("first_name") or d.get("title"),
            "username": d.get("username")}


def _chat(c):
    c = c or {}
    return {"id": c.get("id"), "type": c.get("type"), "title": c.get("title")}


def _reactions(arr):
    """A list of Telegram ReactionType objects -> a flat list of display strings."""
    out = []
    for x in arr or []:
        t = (x or {}).get("type")
        if t == "emoji":
            out.append(x.get("emoji"))
        elif t == "custom_emoji":
            out.append("custom:%s" % x.get("custom_emoji_id"))
        elif t == "paid":
            out.append("⭐")
    return out


def _event_row(u):
    """Non-message updates we ingest: reactions (who reacted, old/new sets) and
    membership changes (my_chat_member / chat_member). Returns a row or None."""
    mr = u.get("message_reaction")
    if mr:
        actor = mr.get("user") or mr.get("actor_chat")
        return {"direction": "in", "kind": "reaction", "update_id": u["update_id"],
                "message_id": mr.get("message_id"),
                "date": mr.get("date"), "iso": _iso(mr.get("date")),
                "chat": _chat(mr.get("chat")), "from": _who(actor),
                "old": _reactions(mr.get("old_reaction")),
                "new": _reactions(mr.get("new_reaction"))}
    mrc = u.get("message_reaction_count")
    if mrc:
        counts = [{"emoji": (_reactions([rc.get("type")]) or [None])[0],
                   "count": rc.get("total_count")}
                  for rc in (mrc.get("reactions") or [])]
        return {"direction": "in", "kind": "reaction_count", "update_id": u["update_id"],
                "message_id": mrc.get("message_id"),
                "date": mrc.get("date"), "iso": _iso(mrc.get("date")),
                "chat": _chat(mrc.get("chat")), "counts": counts}
    pa = u.get("poll_answer")
    if pa:
        # A vote on a poll WE sent. Non-anonymous polls carry `user`; anonymous
        # ones never produce poll_answer at all. option_ids is the voter's CURRENT
        # full selection — Telegram REPLACES it on every change, so the latest row
        # per (poll_id, voter) wins; an empty list means the vote was retracted.
        # poll_answer carries no chat and no date — we stamp receive time so the
        # latest-wins ordering in `pollstatus` has something to sort on.
        voter = pa.get("user") or pa.get("voter_chat")
        now = int(time.time())
        return {"direction": "in", "kind": "poll_answer", "update_id": u["update_id"],
                "poll_id": pa.get("poll_id"), "date": now, "iso": _iso(now),
                "from": _who(voter), "option_ids": pa.get("option_ids") or []}
    which = "my_chat_member" if u.get("my_chat_member") else \
            ("chat_member" if u.get("chat_member") else None)
    if which:
        cm = u[which]
        old, new = cm.get("old_chat_member") or {}, cm.get("new_chat_member") or {}
        return {"direction": "in", "kind": "member", "update_id": u["update_id"],
                "scope": "me" if which == "my_chat_member" else "other",
                "date": cm.get("date"), "iso": _iso(cm.get("date")),
                "chat": _chat(cm.get("chat")), "from": _who(cm.get("from")),
                "user": _who(new.get("user") or old.get("user")),
                "old_status": old.get("status"), "new_status": new.get("status")}
    return None


def ingest(ctx, body):
    """Parse a getUpdates response; append rows; persist offset. Returns True on ok."""
    try:
        d = json.loads(body)
    except Exception:
        return False
    if not d.get("ok"):
        return False
    maxid, rows = None, []
    for u in d.get("result", []):
        maxid = u["update_id"]
        m = u.get("message") or u.get("edited_message")
        if not m:
            ev = _event_row(u)        # reaction / membership updates
            if ev:
                rows.append(ev)
            continue
        ch, fr = m.get("chat") or {}, m.get("from") or {}
        text = m.get("text") or m.get("caption")
        media = extract_media(m)
        raw_keys = sorted(k for k in m if k not in _SKIP) if (not text and not media) else None
        ftc, fte = m.get("forum_topic_created") or {}, m.get("forum_topic_edited") or {}
        if ftc.get("name"):
            tid = m.get("message_thread_id") or m.get("message_id")
            if tid:
                topics_upsert(ctx.topics, int(tid), ftc["name"])
        elif fte.get("name") and m.get("message_thread_id"):
            topics_upsert(ctx.topics, int(m["message_thread_id"]), fte["name"])
        rows.append({
            "direction": "in", "update_id": u["update_id"],
            "message_id": m.get("message_id"), "date": m.get("date"),
            "iso": datetime.datetime.fromtimestamp(m["date"], datetime.UTC).isoformat()
                   if m.get("date") else None,
            "chat": {"id": ch.get("id"), "type": ch.get("type"), "title": ch.get("title")},
            "from": {"id": fr.get("id"), "first_name": fr.get("first_name"),
                     "username": fr.get("username")},
            "thread_id": m.get("message_thread_id"), "text": text, "media": media,
            "raw_keys": raw_keys, "edited": bool(u.get("edited_message")),
        })
    if rows:
        with open(ctx.hist, "a", encoding="utf-8") as f:
            for r in rows:
                f.write(json.dumps(r, ensure_ascii=False) + "\n")
    if maxid is not None:
        with open(ctx.off, "w") as f:
            f.write(str(maxid))
    return True


# ── message identity: (chat_id, message_id) ───────────────────────────────────
#
# A Telegram message_id is unique only WITHIN its chat. #1746 in the staff group
# and #1746 in a DM are two unrelated messages. Anything keyed on the id alone
# therefore conflates them, and every symptom of that is SILENT — nothing raises,
# you simply get someone else's content:
#
#   • media   — the second arrival finds its path taken, so its bytes are never
#               written and the file holds the first sender's photo/voice
#   • text    — `show` printed one message's header above another's transcript
#   • WRITES  — `reply` resolved the chat from the newest row with that id, so a
#               reply to a DM could be delivered into the group
#
# All three were live in production until 2026-07-28. The third is the serious
# one: it is the same private-DM-into-the-staff-group leak `_to()` was hardened
# against, closed at the target-argument door and left open at the message-id one.
#
# So: the identity of a message is the pair (chat_id, message_id), everywhere,
# with no exceptions. thread_id is deliberately NOT part of it — a thread is an
# attribute of a message, not a namespace for its id, and folding it in would
# invent a second way to miss (a message whose thread we failed to record).
#
# Textual form: `<chat>:<msg_id>` — `GROUP:1746`, `-1004412570945:1746`. Every
# surface that PRINTS an id prints it qualified, so anything copy-pasted out of
# `watch` / `pending` is unambiguous by construction. A bare `1746` is still
# accepted — it is what a human reads off a screen — but it is RESOLVED, never
# guessed: unique ⇒ fine, ambiguous ⇒ the command refuses and lists the
# candidates. Refusing is the point. "Pick the newest and mention it in the
# output" is the silent-wrong-answer this replaces: the caller is usually a
# model, and a caveat printed beside plausible-looking content is exactly what
# gets skimmed past.

_REF_RE = re.compile(r"^(?P<chat>[^:#\s]+[:#])?#?(?P<mid>\d+)$")


def parse_ref(raw, cmd):
    """`1746` / `#1746` / `GROUP:1746` / `-1004412570945:1746` → (chat_spec|None, id).
    chat_spec is left symbolic here; resolve_chat() turns it into an id, so an
    alias works anywhere a raw id does."""
    m = _REF_RE.match(str(raw).strip())
    if not m:
        die("%s: %r is not a message ref — pass the bare id (1746) or the qualified "
            "form (GROUP:1746 / -1004412570945:1746) that watch/pending print" % (cmd, raw), 2)
    chat = m.group("chat")
    return (chat[:-1] if chat else None), int(m.group("mid"))


def ref_str(ctx, cid, mid):
    """The canonical printable ref. Alias when the repo names the chat, raw id
    otherwise — either way it round-trips back through parse_ref/resolve_chat."""
    return "%s:%s" % (ctx.chat_alias(cid) or cid, mid)


def load_rows(ctx):
    """history.jsonl as a list, once. Commands used to re-open and re-parse it per
    concern; a single read keeps every view of a message consistent within one run."""
    if not os.path.exists(ctx.hist):
        return []
    out = []
    with open(ctx.hist, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                out.append(json.loads(line))
            except Exception:
                continue
    return out


def is_message(r):
    """A real inbound message — not a reaction / membership / transcript / poll_answer."""
    return r.get("direction") == "in" and not r.get("kind")


def inbound_messages(rows):
    """{(chat_id, message_id): row} — the latest row per identity wins, because
    append-only means an edit lands later under the same identity and supersedes."""
    out = {}
    for r in rows:
        if not is_message(r):
            continue
        cid = (r.get("chat") or {}).get("id")
        mid = r.get("message_id")
        if cid is not None and mid is not None:
            out[(cid, mid)] = r
    return out


def first_arrival(rows):
    """{message_id: chat_id} for the earliest inbound message with each id THAT COULD
    OWN A TRANSCRIPT — one carrying transcribable media.

    Only for reading pre-2026-07-28 data. Back then media download and
    transcription were both gated on the bare id, so whichever message arrived
    first is the one that actually got its bytes and its transcript — the later
    same-numbered ones were skipped. That makes the earliest arrival the correct
    owner of any legacy artefact, and it is why `migrate` can place them without
    guessing.

    Restricting to media messages is load-bearing, not tidiness: ids are shared
    with ordinary TEXT messages too, and taking the earliest message of any kind
    hands a legacy transcript to a text message in another chat. The real voice
    note then looks untranscribed and is sent to the ASR again. That is not
    hypothetical — it is what this function did on its first deploy: an 82s video
    was re-transcribed and re-billed, and a 1s clip came back with a different
    wrong word than the first run."""
    best = {}
    for r in rows:
        if not is_message(r):
            continue
        if (r.get("media") or {}).get("type") not in _TRANSCRIBE:
            continue
        cid = (r.get("chat") or {}).get("id")
        mid = r.get("message_id")
        if cid is None or mid is None:
            continue
        d = r.get("date") or 0
        if mid not in best or d < best[mid][0]:
            best[mid] = (d, cid)
    return {mid: cid for mid, (_d, cid) in best.items()}


def _preview(r, width=48):
    t = (r.get("text") or "").replace("\n", " ").strip()
    if not t:
        med = r.get("media") or {}
        t = "[%s%s]" % (med.get("type", "non-text"), _dur(med.get("duration"))) if med else "[non-text]"
    return t[:width]


def find_ref(ctx, raw, cmd, rows=None):
    """Every inbound message a ref names, oldest first. Never empty: an unknown ref
    is a hard error, since acting on "no such message" is always a mistake."""
    chat_spec, mid = parse_ref(raw, cmd)
    msgs = inbound_messages(rows if rows is not None else load_rows(ctx))
    hits = [(cid, r) for (cid, m), r in msgs.items() if m == mid]
    if chat_spec is not None:
        want = int(ctx.resolve_chat(chat_spec))
        hits = [h for h in hits if h[0] == want]
        if not hits:
            die("%s: no inbound message %s in history — check the chat, or poll first"
                % (cmd, ref_str(ctx, want, mid)), 2)
    if not hits:
        die("%s: no inbound message #%s in any chat in history (poll first?)" % (cmd, mid), 2)
    hits.sort(key=lambda h: h[1].get("date") or 0)
    return [r for _cid, r in hits]


def resolve_ref(ctx, raw, cmd, rows=None):
    """Exactly one message, or a hard error listing the candidates. The primitive
    for anything that ACTS on a message (reply / react / delete): a write into the
    wrong chat cannot be taken back, so ambiguity fails closed rather than
    resolving to a best guess."""
    hits = find_ref(ctx, raw, cmd, rows)
    if len(hits) == 1:
        return hits[0]
    _mid = hits[0].get("message_id")
    lines = ["%s: #%s is ambiguous — %d chats hold a message with that id, and "
             "picking one for you is how a DM ends up in the group:" % (cmd, _mid, len(hits))]
    for r in hits:
        cid = (r.get("chat") or {}).get("id")
        lines.append("      %-26s %-12s %s  %s" % (
            ref_str(ctx, cid, _mid), (r.get("from") or {}).get("first_name") or "?",
            r.get("iso") or "?", _preview(r)))
    lines.append("  name the one you mean: `tg %s %s …`"
                 % (cmd, ref_str(ctx, (hits[-1].get("chat") or {}).get("id"), _mid)))
    die("\n".join(lines), 2)


# ── media backfill + transcription (ElevenLabs Scribe) ────────────────────────

_EXT = {"voice": "ogg", "audio": "mp3", "video_note": "mp4", "video": "mp4",
        "animation": "mp4", "photo": "jpg", "sticker": "webp"}
_TRANSCRIBE = {"voice", "audio", "video_note", "video"}


def media_ext(med):
    """A document keeps its own extension; everything else takes its type default."""
    if med.get("type") == "document" and med.get("file_name") and "." in med["file_name"]:
        return med["file_name"].rsplit(".", 1)[-1].lower()
    return _EXT.get(med.get("type"), "bin")


def media_path(ctx, cid, mid, ext):
    """`media/<chat_id>/<message_id>.<ext>` — pure, no mkdir, so `migrate` can
    compute destinations freely.

    The chat directory is the whole fix: it is what keeps two same-numbered
    messages from different chats off one path. A chat DIRECTORY rather than a
    `<chat>_<msg>` filename prefix, because chat ids are negative and a file
    named `-1004412570945_1746.ogg` starts with a dash — every bare `cat`/`rm` of
    it would parse as flags. Inside a directory the dash never leads the argument."""
    return os.path.join(ctx.media, str(cid), "%s.%s" % (mid, ext))


def transcript_key(r, legacy_owner):
    """(chat_id, message_id) a transcript row belongs to.

    Rows written from 2026-07-28 carry their own `chat`, like every other row.
    LEGACY rows carry only `ref_message_id`, so they are attributed to the first
    arrival (see first_arrival) — correct by construction, not a guess."""
    mid = r.get("ref_message_id")
    if mid is None:
        return None
    cid = (r.get("chat") or {}).get("id")
    if cid is None:
        cid = legacy_owner.get(mid)
    return None if cid is None else (cid, mid)


def _eleven_key(ctx):
    k = ctx.get("TG_ELEVENLABS_KEY")
    if not k:
        raise RuntimeError("no TG_ELEVENLABS_KEY (env, .env, or tg.conf)")
    return k.strip()


def _has_eleven(ctx):
    return bool(ctx.get("TG_ELEVENLABS_KEY"))


# ── transcript trust ──────────────────────────────────────────────────────────
#
# A transcript is ASR output, not typed words, and the failure that matters is
# not a garbled string (obvious) but a CONFIDENT WRONG WORD (invisible). Short
# clips are where it happens: 1-4s gives language auto-detection almost nothing
# to lock onto, so "tahine" came back as taurine / tarine / farine, and one 2s
# note came back in Arabic script from a French/Portuguese kitchen. The farine
# one mattered — flour in the hummus would have cost the batch.
#
# Three levers, in order of how much they cost the caller:
#
#   1. FORCE the language per chat (TG_TRANSCRIBE_LANG_<ALIAS>) instead of only
#      globally. A shop can mix fr/pt/en across chats while one person's DM is
#      reliably one language — that is where auto-detect is pure downside.
#   2. KEEP what the engine already tells us. We were parsing `text` out of the
#      response and dropping language_code / language_probability on the floor —
#      i.e. throwing away the exact confidence signal, then wishing for it.
#   3. FLAG the implausible: a detected language or a writing system that cannot
#      be right for this chat (TG_TRANSCRIBE_EXPECT=fr,pt,en). Flag, never drop —
#      a suppressed transcript is a message nobody reads, which is worse than a
#      wrong one somebody can see is wrong.
#
# Short clips raise the confidence BAR rather than raising a flag of their own:
# most 2s notes ("oui", "ok") transcribe perfectly, and warning on all of them
# trains the reader to ignore the warning — the same way a permanently-stuck
# `pending` entry trains you to ignore `pending`.

SHORT_CLIP_SECS = 3
LANG_CONF_FLOOR = 0.5
LANG_CONF_FLOOR_SHORT = 0.8      # auto-detect on a few seconds of audio: demand more

_SCRIPTS = [
    ("arabic", r"[؀-ۿݐ-ݿ]"), ("hebrew", r"[֐-׿]"),
    ("cyrillic", r"[Ѐ-ӿ]"), ("greek", r"[Ͱ-Ͽ]"),
    ("devanagari", r"[ऀ-ॿ]"), ("thai", r"[฀-๿]"),
    ("hangul", r"[가-힯ᄀ-ᇿ]"),
    ("cjk", r"[一-鿿぀-ヿ]"),
    ("latin", r"[A-Za-zÀ-ɏ]"),
]
_LANG_SCRIPT = {
    "fr": "latin", "pt": "latin", "en": "latin", "de": "latin", "es": "latin",
    "it": "latin", "nl": "latin", "pl": "latin", "tr": "latin", "id": "latin",
    "vi": "latin", "sv": "latin", "da": "latin", "no": "latin", "fi": "latin",
    "cs": "latin", "ro": "latin", "hu": "latin", "ca": "latin", "af": "latin",
    "ru": "cyrillic", "uk": "cyrillic", "bg": "cyrillic", "sr": "cyrillic",
    "ar": "arabic", "fa": "arabic", "ur": "arabic", "he": "hebrew",
    "hi": "devanagari", "th": "thai", "ko": "hangul", "zh": "cjk", "ja": "cjk",
    "el": "greek",
}


def _chat_cfg(ctx, cid, base):
    """Per-chat config with a global fallback: `<BASE>_<ALIAS>`, then `<BASE>_<chat_id>`,
    then `<BASE>`. The alias form is the one to use — a raw chat id is negative, so
    `TG_TRANSCRIBE_LANG_-100…` is legal in tg.conf but not as a shell env var."""
    alias = ctx.chat_alias(cid)
    for key in ([("%s_%s" % (base, alias))] if alias else []) + \
               ([("%s_%s" % (base, cid))] if cid is not None else []) + [base]:
        v = (ctx.get(key) or "").strip()
        if v:
            return v
    return None


def transcribe_lang(ctx, cid):
    """Forced language for a chat, or None to let the engine auto-detect."""
    return _chat_cfg(ctx, cid, "TG_TRANSCRIBE_LANG")


# ISO 639-2/3 → 639-1. Scribe answers in three-letter codes ("fra", "por"), config
# is written in two ("fr", "pt"), and the two only coincide sometimes: fra→fr and
# eng→en survive a naive truncation, but por→"po" and spa→"sp" do not. Truncating
# would have flagged every Portuguese note in a French/Portuguese kitchen as
# implausible — a false alarm on half the traffic, which is how a warning becomes
# noise and then becomes ignored.
_LANG3 = {
    "fra": "fr", "fre": "fr", "por": "pt", "eng": "en", "deu": "de", "ger": "de",
    "spa": "es", "ita": "it", "nld": "nl", "dut": "nl", "pol": "pl", "tur": "tr",
    "ind": "id", "vie": "vi", "swe": "sv", "dan": "da", "nor": "no", "nob": "no",
    "fin": "fi", "ces": "cs", "cze": "cs", "ron": "ro", "rum": "ro", "hun": "hu",
    "cat": "ca", "afr": "af", "rus": "ru", "ukr": "uk", "bul": "bg", "srp": "sr",
    "ara": "ar", "fas": "fa", "per": "fa", "urd": "ur", "heb": "he", "hin": "hi",
    "tha": "th", "kor": "ko", "zho": "zh", "chi": "zh", "jpn": "ja", "ell": "el",
    "gre": "el",
}


def norm_lang(code):
    """Any language code → its two-letter form, or None."""
    c = (code or "").strip().lower().replace("_", "-").split("-")[0]
    if not c:
        return None
    return c if len(c) == 2 else _LANG3.get(c, c[:2])


def expected_langs(ctx, cid):
    """Languages this chat can plausibly be in. An explicit TG_TRANSCRIBE_EXPECT
    wins; otherwise a forced language implies itself. Empty ⇒ no expectation
    declared ⇒ we make no claim and flag nothing on these grounds."""
    v = _chat_cfg(ctx, cid, "TG_TRANSCRIBE_EXPECT") or transcribe_lang(ctx, cid)
    return [x for x in (norm_lang(p) for p in (v or "").replace(";", ",").split(",")) if x]


def dominant_script(text):
    """The writing system most of the letters belong to, or None if there are none."""
    best, best_n = None, 0
    for name, pat in _SCRIPTS:
        n = len(re.findall(pat, text))
        if n > best_n:
            best, best_n = name, n
    return best


def transcript_flags(ctx, cid, duration, res, forced):
    """Reasons to distrust this transcript, as short human strings. Empty = nothing
    detectably wrong (NOT a promise that it is right)."""
    flags = []
    short = isinstance(duration, int) and duration <= SHORT_CLIP_SECS
    conf = res.get("lang_confidence")
    floor = LANG_CONF_FLOOR_SHORT if (short and not forced) else LANG_CONF_FLOOR
    if isinstance(conf, (int, float)) and conf < floor:
        flags.append("language %.0f%% sure%s" % (conf * 100, " on a %ds clip" % duration if short else ""))
    expect = expected_langs(ctx, cid)
    det = norm_lang(res.get("detected_lang"))
    if expect and det and det not in expect:
        flags.append("detected %s, expected %s" % (det, "/".join(expect)))
    if expect:
        want = {_LANG_SCRIPT[l] for l in expect if l in _LANG_SCRIPT}
        got = dominant_script(res.get("text") or "")
        if want and got and got not in want:
            flags.append("%s script in a %s chat" % (got, "/".join(sorted(want))))
    return flags


def transcribe(ctx, path, lang=None):
    """Audio → {text, detected_lang, lang_confidence}. Returns the engine's own
    language metadata alongside the words; whether a given Scribe model populates
    it is not something we can assume, so absent fields stay None and the flags
    that depend on them simply don't fire."""
    fname = os.path.basename(path)
    ctype = mimetypes.guess_type(fname)[0] or "application/octet-stream"
    with open(path, "rb") as fh:
        data = fh.read()
    fields = {"model_id": "scribe_v2"}
    if lang:
        fields["language_code"] = lang
    j = api_post_multipart_raw(
        "https://api.elevenlabs.io/v1/speech-to-text",
        fields, {"file": (fname, data, ctype)},
        headers={"xi-api-key": _eleven_key(ctx)}, timeout=300)
    txt = (j.get("text") or "").strip()
    if not txt:
        raise RuntimeError("empty transcript: %s" % json.dumps(j)[:300])
    return {"text": txt, "detected_lang": j.get("language_code"),
            "lang_confidence": j.get("language_probability")}


def api_post_multipart_raw(url, fields, files, headers, timeout=120):
    boundary, body = _multipart(fields, files)
    h = dict(headers)
    h["Content-Type"] = "multipart/form-data; boundary=%s" % boundary
    return json.loads(_http(url, data=body, headers=h, timeout=timeout, method="POST"))


def tts(ctx, text, out_path):
    voice = ctx.get("TG_ELEVENLABS_VOICE_ID")
    if not voice:
        raise RuntimeError("TG_ELEVENLABS_VOICE_ID unset — pick a voice id (.env / tg.conf)")
    model = ctx.get("TG_ELEVENLABS_TTS_MODEL") or "eleven_multilingual_v2"
    body = json.dumps({"text": text, "model_id": model}).encode()
    audio = _http("https://api.elevenlabs.io/v1/text-to-speech/%s" % voice,
                  data=body, headers={"xi-api-key": _eleven_key(ctx),
                                      "Content-Type": "application/json"},
                  timeout=120, method="POST")
    if not audio:
        raise RuntimeError("empty TTS audio")
    with open(out_path, "wb") as f:
        f.write(audio)
    return len(audio)


def fetch_media(ctx):
    """Idempotent backfill: download every inbound attachment we haven't got, and
    transcribe the audio ones. Both steps are keyed on (chat_id, message_id) — on
    the bare id they used to collide, and a collision meant the second message was
    quietly skipped for BOTH, leaving the first sender's file and words sitting
    under the second sender's name."""
    rows = load_rows(ctx)
    if not rows:
        return
    legacy_owner = first_arrival(rows)
    transcribed = set()
    for r in rows:
        if r.get("kind") == "transcript":
            k = transcript_key(r, legacy_owner)
            if k:
                transcribed.add(k)
    for r in rows:
        if not is_message(r):
            continue
        med = r.get("media")
        if not med or not med.get("file_id"):
            continue
        cid = (r.get("chat") or {}).get("id")
        mid = r.get("message_id")
        if cid is None or mid is None:
            continue
        ref = ref_str(ctx, cid, mid)
        dest = media_path(ctx, cid, mid, media_ext(med))
        if not os.path.exists(dest):
            try:
                j = api_get(ctx, "getFile", {"file_id": med["file_id"]})
                if not j.get("ok"):
                    raise RuntimeError("getFile: %s" % j.get("description"))
                data = _http("%s/%s" % (ctx.filebase, j["result"]["file_path"]))
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                with open(dest, "wb") as out:
                    out.write(data)
                sys.stderr.write("media: saved %s -> %s (%d bytes)\n" % (ref, dest, len(data)))
            except Exception as e:
                sys.stderr.write("media: FAILED %s: %s\n" % (ref, e))
                continue
        if med["type"] in _TRANSCRIBE and (cid, mid) not in transcribed:
            if not _has_eleven(ctx):
                continue  # bytes are downloaded; transcription needs a key — skip quietly
            forced = transcribe_lang(ctx, cid)
            try:
                res = transcribe(ctx, dest, forced)
            except Exception as e:
                sys.stderr.write("transcribe: FAILED %s: %s\n" % (ref, e))
                continue
            txt = res["text"]
            flags = transcript_flags(ctx, cid, (med or {}).get("duration"), res, forced)
            with open(os.path.splitext(dest)[0] + ".txt", "w", encoding="utf-8") as tf:
                tf.write(txt)
            meta = {"direction": "meta", "kind": "transcript",
                    "chat": {"id": cid}, "ref_message_id": mid,
                    "date": int(time.time()), "engine": "elevenlabs:scribe_v2",
                    "lang": forced or "auto", "detected_lang": res.get("detected_lang"),
                    "lang_confidence": res.get("lang_confidence"),
                    "duration": (med or {}).get("duration"),
                    "flags": flags, "media_path": dest, "text": txt}
            with open(ctx.hist, "a", encoding="utf-8") as f:
                f.write(json.dumps(meta, ensure_ascii=False) + "\n")
            transcribed.add((cid, mid))
            sys.stderr.write("transcribe: %s -> %d chars%s\n" % (
                ref, len(txt), "  ⚠ " + "; ".join(flags) if flags else ""))


# ── poller (singleton long-poll daemon) ───────────────────────────────────────

# A healthy long-poll iteration returns within ~35s (30s server timeout + slack).
# STALL = the in-process watchdog force-restarts past this; DEAD = an external
# checker (doctor / watch) treats a stale heartbeat as dead. DEAD > STALL so the
# poller gets first crack at restarting itself before anyone double-spawns it.
POLL_STALL_SECS = 90
POLLER_DEAD_SECS = 150

# Opt into reaction + membership + poll-vote updates. allowed_updates REPLACES
# Telegram's default set (it doesn't add to it), so the message types we still
# want must be listed too. message_reaction / message_reaction_count /
# chat_member / poll_answer are NOT in the default set — without this they never
# arrive. Caveat: a *user's* reaction (message_reaction) only reaches a bot that
# is an admin in the group; otherwise just the anonymous message_reaction_count
# aggregate is delivered. Likewise poll_answer carries the individual voter ONLY
# for non-anonymous polls (`sendpoll --public`); anonymous polls reveal no voters.
_ALLOWED_UPDATES = json.dumps([
    "message", "edited_message",
    "message_reaction", "message_reaction_count",
    "my_chat_member", "chat_member", "poll_answer",
])


def _beat(ctx):
    try:
        os.utime(ctx.beat, None)
    except OSError:
        open(ctx.beat, "w").close()


def poller_alive(ctx):
    p = _read(ctx.pid)
    if not p:
        return False
    try:
        os.kill(int(p), 0)
    except (OSError, ValueError):
        return False
    # An alive PID is necessary but not sufficient: it can be a poller wedged in
    # a dead long-poll socket (offset frozen forever), or a stale pidfile whose
    # number got reused by an unrelated live process (e.g. the claude session) —
    # the false-healthy trap. Require a fresh heartbeat too. A poller writes its
    # beat *before* its pidfile (see cmd_poll), so a live owner always has one;
    # therefore a missing or stale beat means "not a healthy poller" → dead.
    try:
        return time.time() - os.path.getmtime(ctx.beat) <= POLLER_DEAD_SECS
    except OSError:
        return False


def cmd_poll(ctx, _a):
    if poller_alive(ctx):
        print("poller already running (pid %s)" % _read(ctx.pid)); return
    mypid = os.getpid()
    _beat(ctx)                       # beat before pidfile: a live owner always has a heartbeat
    with open(ctx.pid, "w") as f:
        f.write(str(mypid))

    def _cleanup(*_):
        if _read(ctx.pid) == str(mypid):
            try: os.remove(ctx.pid)
            except OSError: pass
        sys.exit(0)
    signal.signal(signal.SIGINT, _cleanup)
    signal.signal(signal.SIGTERM, _cleanup)

    def _watchdog():
        # Out-of-band liveness: if the loop hasn't completed an iteration within
        # POLL_STALL_SECS (heartbeat gone stale), it's wedged in getUpdates with
        # no way to unblock itself from the main thread — force-exit so the box
        # supervisor respawns us. This is what 'alive PID' liveness can't catch.
        while True:
            time.sleep(15)
            if _read(ctx.pid) != str(mypid):
                return  # reclaimed; main loop will stand down on its own
            try:
                stale = time.time() - os.path.getmtime(ctx.beat)
            except OSError:
                continue
            if stale > POLL_STALL_SECS:
                with open(ctx.plog, "a") as f:
                    f.write("poller %s stalled %ds in getUpdates — force-restarting\n"
                            % (mypid, int(stale)))
                os._exit(1)
    threading.Thread(target=_watchdog, daemon=True).start()

    open(ctx.hist, "a").close()
    print("poller started (pid %s), cursor %s" % (mypid, _read(ctx.off) or "0"))
    backoff = 0
    try:
        while True:
            # Singleton invariant: pidfile owner wins; a reclaimed loop stands down.
            if _read(ctx.pid) != str(mypid):
                print("pidfile reclaimed by another poller — %s standing down" % mypid)
                return
            _beat(ctx)  # progress heartbeat: one tick per completed long-poll
            if backoff:
                time.sleep(backoff)
            off = _read(ctx.off)
            off = int(off) if off.isdigit() else 0
            params = {"timeout": 30, "limit": 100, "allowed_updates": _ALLOWED_UPDATES}
            if off > 0:
                params["offset"] = off + 1
            try:
                body = _http("%s/getUpdates?%s" % (ctx.api, urllib.parse.urlencode(params)),
                             timeout=35, opener=_KEEPALIVE_OPENER)
            except Exception:
                body = b""
            if not body:
                backoff = 1 if backoff == 0 else min(backoff * 2, 60); continue
            if ingest(ctx, body):
                backoff = 0
                fetch_media(ctx)
            else:
                backoff = 1 if backoff == 0 else min(backoff * 2, 60)
    finally:
        _cleanup()


def cmd_doctor(ctx, _a):
    n = len(legacy_media(ctx))
    if n:
        # Loud, because the flat layout is the state in which two chats can share a
        # media path — and its symptom is reading someone else's file, not an error.
        print("⚠ %d media file(s) still in the legacy flat layout — run `tg migrate`" % n)
    if poller_alive(ctx):
        print("poller alive (pid %s)" % _read(ctx.pid)); return
    try: os.remove(ctx.pid)
    except OSError: pass
    log = open(ctx.plog, "a")
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "poll"],
                     stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                     start_new_session=True, cwd=ctx.root)
    time.sleep(1)
    print("poller restarted (detached, pid %s)" % _read(ctx.pid) if poller_alive(ctx)
          else "poller restart attempted (see %s)" % ctx.plog)


# ── watch (Monitor stream) ────────────────────────────────────────────────────

_ICON = {"voice": "🎤", "audio": "🎵", "photo": "🖼️", "document": "📎", "video": "🎞️",
         "video_note": "🎥", "animation": "🎞️", "sticker": "🩹"}
_WATCH_TRANSCRIBE = {"voice", "audio", "video_note", "video"}


def _dur(s):
    try:
        s = int(s)
    except (TypeError, ValueError):
        return ""
    return " %d:%02d" % (s // 60, s % 60)


def _fmt_line(ctx, r, watched, topics_cache):
    if r.get("kind") == "transcript":
        cid = (r.get("chat") or {}).get("id")
        if watched is not None and cid is not None and cid not in watched:
            return None
        t = (r.get("text") or "").replace("\n", " / ")
        ref = ref_str(ctx, cid, r.get("ref_message_id")) if cid is not None \
            else "#%s" % r.get("ref_message_id")
        flags = r.get("flags") or []
        # A flagged transcript says so ON THE LINE that wakes the reader. Anything
        # quieter (a field only `show` prints) is a warning nobody sees in time —
        # and acting on a confidently-wrong word is the whole failure mode.
        warn = "  ⚠ %s" % "; ".join(flags) if flags else ""
        return "MSG [voice transcript %s]%s: %s" % (ref, warn, t)
    if r.get("direction") != "in":
        return None
    if r.get("kind") == "poll_answer":
        # No chat on a poll_answer, so it bypasses the watched-chat filter below
        # (it'd be dropped otherwise). Live view shows option indices; `tg
        # pollstatus` resolves them to option text and tallies who's missing.
        who = (r.get("from") or {}).get("first_name") or "?"
        opts = r.get("option_ids") or []
        sel = "options " + ",".join(map(str, opts)) if opts else "(retracted)"
        return "POLL %s → %s (poll …%s)" % (who, sel, (r.get("poll_id") or "")[-6:])
    chat = r.get("chat") or {}
    if watched is not None and chat.get("id") not in watched:
        return None
    kind = r.get("kind")
    if kind == "reaction":
        who = (r.get("from") or {}).get("first_name") or "?"
        old, new = r.get("old") or [], r.get("new") or []
        added = [e for e in new if e not in old]
        removed = [e for e in old if e not in new]
        chg = ("+" + " ".join(added) if added else "") + \
              (" -" + " ".join(removed) if removed else "")
        return "RXN %s on msg %s: %s" % (who, r.get("message_id"), chg.strip() or "(cleared)")
    if kind == "reaction_count":
        summary = " ".join("%s×%s" % (c.get("emoji"), c.get("count"))
                           for c in (r.get("counts") or [])) or "(none)"
        return "RXN (count) msg %s: %s" % (r.get("message_id"), summary)
    if kind == "member":
        who = (r.get("user") or {}).get("first_name") or "?"
        scope = "this bot" if r.get("scope") == "me" else "member"
        return "MBR %s [%s]: %s → %s" % (who, scope, r.get("old_status"), r.get("new_status"))
    name = (r.get("from") or {}).get("first_name") or "?"
    tid = r.get("thread_id")
    topic_tag = ""
    if tid is not None:
        # reverse topics map, refreshed on mtime change
        try:
            mt = os.stat(ctx.topics).st_mtime
        except FileNotFoundError:
            mt = None
        if mt is not None and mt != topics_cache.get("mtime"):
            topics_cache["rev"] = {v: k for k, v in topics_load(ctx.topics).items()}
            topics_cache["mtime"] = mt
        nm = topics_cache.get("rev", {}).get(int(tid))
        topic_tag = "#%s" % nm if nm else "#thread:%s" % tid
    # The leading bracket names the channel by IDENTITY and carries its chat_id,
    # so a reply can target the originating chat mechanically — never by guessing
    # an alias from an ambiguous type tag (the trap where a Backoffice `group`
    # and the OPS `supergroup` both render as "[group]"). A tg.conf alias wins;
    # otherwise we fall back to "DM" (private) or the raw Telegram type. Forum
    # supergroups still carry the topic the message landed in. The `#<id>` after
    # the sender is the message id — feed it to `tg reply` to answer in place.
    cid = chat.get("id")
    label = ctx.chat_alias(cid) or ("DM" if chat.get("type") == "private"
                                    else (chat.get("type") or "?"))
    bits = [label] + ([str(cid)] if cid is not None else []) + ([topic_tag] if topic_tag else [])
    prefix = "[%s] " % " ".join(bits)
    mid = r.get("message_id")
    # The ref is printed QUALIFIED (`#GROUP:1746`, not `#1746`) even though the
    # bracket already names the chat: the id is the token that gets copied out of
    # this line into `tg reply`, often days later and without the bracket, and a
    # bare id silently means a different message in another chat.
    name = "%s #%s" % (name, ref_str(ctx, cid, mid)) if mid is not None else name
    txt = r.get("text")
    if txt:
        return "MSG %s%s: %s" % (prefix, name, txt.replace("\n", " / "))
    med = r.get("media")
    if med:
        kind = med.get("type", "media")
        tail = " — transcribing…" if kind in _WATCH_TRANSCRIBE else " [media saved]"
        return "MSG %s%s: %s %s%s%s" % (prefix, name, _ICON.get(kind, "📦"),
                                        kind, _dur(med.get("duration")), tail)
    rk = r.get("raw_keys")
    if rk:
        return "MSG %s%s: (no text/media — telegram fields: %s)" % (prefix, name, ", ".join(rk))
    return "MSG %s%s: (non-text message, no media — check Telegram)" % (prefix, name)


def cmd_watch(ctx, _a):
    open(ctx.hist, "a").close()
    cmd_doctor(ctx, None)
    fetch_media(ctx)
    _w = (ctx.get("TG_WATCHED_CHATS") or "").strip()
    watched = {int(x) for x in _w.split(",") if x.strip().lstrip("-").isdigit()} if _w else None
    topics_cache = {"mtime": None, "rev": {}}
    last_watchdog = time.time()
    with open(ctx.hist, encoding="utf-8") as f:
        f.seek(0, os.SEEK_END)
        while True:
            line = f.readline()
            if not line:
                if time.time() - last_watchdog > 60:
                    last_watchdog = time.time()
                    if not poller_alive(ctx):
                        cmd_doctor(ctx, None)
                        print("[watchdog] poller was dead — restarted", flush=True)
                time.sleep(0.5)
                continue
            line = line.strip()
            if not line:
                continue
            try:
                r = json.loads(line)
            except Exception:
                continue
            out = _fmt_line(ctx, r, watched, topics_cache)
            if out:
                print(out, flush=True)


# ── outbound + utility commands ───────────────────────────────────────────────

def _log_out(ctx, chat, result, extra=None):
    row = {"direction": "out", "message_id": result.get("message_id"),
           "date": result.get("date"),
           "iso": datetime.datetime.fromtimestamp(result["date"], datetime.UTC).isoformat()
                  if result.get("date") else None,
           "chat": {"id": int(chat)}, "thread_id": result.get("message_thread_id"),
           "text": result.get("text") or result.get("caption")}
    if extra:
        row.update(extra)
    with open(ctx.hist, "a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")


def _to(a):
    """Resolve the REQUIRED target chat: the leading positional `to`, else the
    `--to` flag. There is no group default — a target must be named explicitly
    (`group`/`team`, a tg.conf alias, or a numeric id). One rule for every
    outbound command so a model never has to recall which take a flag vs a
    positional.

    Omitting the target is an ERROR, not a silent broadcast to the group: an
    absent target is almost always one a broken shell quote swallowed, and
    defaulting that to the group is the footgun that leaked a private DM into the
    staff group. (Target-first argument order + this hard error together close it:
    the fragile free-form message goes last where it can't eat the target, and a
    lost target fails closed instead of broadcasting.) An empty ("") target — the
    unset-$VAR case — and giving both the positional and --to are likewise
    refused."""
    to, to_flag = getattr(a, "to", None), getattr(a, "to_flag", None)
    if to is not None and to_flag is not None and to.strip() != to_flag.strip():
        die("target given twice (positional %r and --to %r) — pass it once" % (to, to_flag), 2)
    chosen = to if to is not None else to_flag
    if chosen is None:
        die("no target chat — name one explicitly: `group`/`team`, a tg.conf alias, "
            "or a numeric chat id. The group is never a silent default: a swallowed "
            "target must fail, not broadcast a DM to everyone. Usage: tg <cmd> <to> …", 2)
    if not chosen.strip():
        die("empty target chat — usually an unset $VAR; refused so a DM never lands in "
            "the wrong chat. Name the target explicitly (`group`/`team`, an alias, or an id).", 2)
    return chosen


def _thread_for(ctx, topic_name, topic_id):
    if topic_id and topic_name:
        die("pass only one of --topic / --topic-id", 2)
    if topic_id:
        if not re.fullmatch(r"\d+", str(topic_id)):
            die("invalid --topic-id '%s'" % topic_id, 2)
        return str(topic_id)
    if topic_name:
        tid = topics_resolve(ctx.topics, topic_name)
        if tid is None:
            die("unknown topic '%s' (list: tg topics)" % topic_name, 2)
        return str(tid)
    return None


def _msg_text(a):
    """Message text: the inline positional, or --file PATH. --file sidesteps the
    shell-quoting trap (a stray ' or " in inline text closes the shell string
    mid-message) — write the message to a file and pass the path. With target-first
    argument order the target is parsed before the text, so --file needs no special-
    casing to tell them apart. Trailing newline stripped."""
    if getattr(a, "text_file", None):
        if getattr(a, "text", None) is not None:
            die("give the message either inline or via --file, not both", 2)
        try:
            with open(a.text_file, encoding="utf-8") as f:
                text = f.read().rstrip("\n")
        except OSError as e:
            die("cannot read --file: %s" % e, 2)
        if not text:
            die("--file %s is empty" % a.text_file, 2)
        return text
    if getattr(a, "text", None) is None:
        die("no message text (pass it inline or via --file PATH)", 2)
    return a.text


def cmd_send(ctx, a):
    # `send --to X <msg>`: both positionals are optional, so argparse drops <msg>
    # into the leading `to` slot. If --to already named the target, the lone
    # positional is really the message — shift it back.
    if a.to_flag is not None and a.text is None and a.to is not None:
        a.text, a.to = a.to, None
    # A single positional lands in `to` (recipient-first), leaving no text — the
    # classic old-habit slip (`tg send "my message"`). Teach the new order here
    # rather than let it fall through to a bare "no message text".
    if a.text is None and not a.text_file and a.to is not None and a.to_flag is None:
        die("no message text — order is `tg send <to> <text>` (recipient first). You gave "
            "only %r; add the message after the target, or use --file PATH." % a.to, 2)
    text = _msg_text(a)
    to = ctx.resolve_chat(_to(a))
    thread = _thread_for(ctx, a.topic, a.topic_id)
    if a.dry_run:
        print("DRY: to=%s thread=%s html=%s len=%d" % (to, thread or "General", a.html, len(text)))
        return
    fields = {"chat_id": to, "text": text}
    if a.html:
        fields["parse_mode"] = "HTML"
    if thread:
        fields["message_thread_id"] = thread
    j = api_post(ctx, "sendMessage", fields)
    if not j.get("ok"):
        die("send failed: %s" % j.get("description"))
    _log_out(ctx, to, j["result"])
    print("ok msg %s" % j["result"].get("message_id"))


def _resolve_msg_target(ctx, a, raw, cmd):
    """(chat_id, message_id) for a message-id-primary command (react / delete).

    Three ways to name the chat, in precedence order: an explicit --to (which also
    reaches a message we never ingested), a qualified ref (GROUP:1746), or history
    lookup of a bare id — and that last one REFUSES rather than guess when several
    chats hold the id. Never the group by default; an unknown message with no --to
    is a hard error, not a broadcast."""
    chat_spec, mid = parse_ref(raw, cmd)
    override = getattr(a, "to_flag", None)
    if override and chat_spec and \
            str(ctx.resolve_chat(override)) != str(ctx.resolve_chat(chat_spec)):
        die("%s: --to %s contradicts the ref %s — pass one or the other, not two "
            "different chats" % (cmd, override, raw), 2)
    if override or chat_spec:
        return ctx.resolve_chat(override or chat_spec), mid
    origin = resolve_ref(ctx, raw, cmd)
    cid = (origin.get("chat") or {}).get("id")
    if cid is None:
        die("%s: message #%s carries no chat id" % (cmd, mid), 2)
    return str(cid), mid


def cmd_reply(ctx, a):
    """Reply to a specific inbound message BY its id — the foolproof primitive:
    the target chat (and forum thread) is resolved from history.jsonl, never
    inferred, and the reply is threaded with reply_to_message_id. Use the `#<id>`
    shown after the sender in `tg watch` / `tg pending` lines. This is the safe
    way to answer the channel a message came from when several look alike."""
    text = _msg_text(a)
    origin = resolve_ref(ctx, a.msg_id, "reply")
    mid = origin.get("message_id")
    to = (origin.get("chat") or {}).get("id")
    if to is None:
        die("reply: message #%s carries no chat id" % mid, 2)
    fields = {"chat_id": str(to), "text": text, "reply_to_message_id": str(mid),
              "allow_sending_without_reply": "true"}  # deleted origin still delivers
    if a.html:
        fields["parse_mode"] = "HTML"
    tid = origin.get("thread_id")
    if tid is not None:
        fields["message_thread_id"] = str(tid)
    j = api_post(ctx, "sendMessage", fields)
    if not j.get("ok"):
        die("reply failed: %s" % j.get("description"))
    _log_out(ctx, str(to), j["result"])
    print("ok msg %s → reply to %s in [%s %s]" % (
        j["result"].get("message_id"), ref_str(ctx, to, mid), ctx.chat_alias(to) or to, to))


def cmd_sendvoice(ctx, a):
    to = ctx.resolve_chat(_to(a))
    if not _which("ffmpeg"):
        die("sendvoice: ffmpeg required", 3)
    import tempfile, shutil
    tmp = tempfile.mkdtemp(prefix="tgvoice.")
    try:
        mp3, ogg = os.path.join(tmp, "v.mp3"), os.path.join(tmp, "v.ogg")
        tts(ctx, a.text, mp3)
        if subprocess.run(["ffmpeg", "-y", "-i", mp3, "-c:a", "libopus", "-b:a", "48k",
                           ogg, "-loglevel", "error"]).returncode != 0:
            die("sendvoice: transcode failed", 5)
        with open(ogg, "rb") as f:
            j = api_post_multipart(ctx, "sendVoice", {"chat_id": to},
                                   {"voice": ("v.ogg", f.read(), "audio/ogg")})
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    if not j.get("ok"):
        die("sendVoice failed: %s" % j.get("description"))
    r = j["result"]; v = r.get("voice") or {}
    _log_out(ctx, to, r, extra={"text": a.text, "media": {
        "type": "voice", "file_id": v.get("file_id"), "file_unique_id": v.get("file_unique_id"),
        "mime": v.get("mime_type"), "duration": v.get("duration"),
        "file_size": v.get("file_size"), "file_name": None, "tts": True}})
    print("ok voice msg %s (%ss)" % (r.get("message_id"), v.get("duration")))


