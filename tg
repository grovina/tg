def legacy_media(ctx):
    """Flat `media/<msg_id>.<ext>` files left from before the layout was chat-scoped."""
    out = []
    try:
        names = os.listdir(ctx.media)
    except OSError:
        return out
    for name in sorted(names):
        if os.path.isfile(os.path.join(ctx.media, name)):
            out.append(name)
    return out


def cmd_migrate(ctx, a):
    """Move legacy flat media (`media/<msg_id>.<ext>`) into the chat-scoped layout
    (`media/<chat_id>/<msg_id>.<ext>`). Idempotent; `--dry-run` previews.

    Placement is derived, not guessed: download used to be gated on the bare id, so
    the bytes on disk belong to the FIRST message that arrived with that id — the
    later same-numbered ones found the path taken and were skipped. That also makes
    the losses enumerable, and they are listed at the end: their file_ids are still
    in history, so `tg media` simply fetches them, now into distinct paths."""
    rows = load_rows(ctx)
    owners, audio = {}, {}
    transcribed = {r.get("ref_message_id") for r in rows if r.get("kind") == "transcript"}
    for r in rows:
        if not is_message(r):
            continue
        med = r.get("media")
        if not med or not med.get("file_id"):
            continue
        cid = (r.get("chat") or {}).get("id")
        mid = r.get("message_id")
        if cid is None or mid is None:
            continue
        d = r.get("date") or 0
        owners.setdefault((mid, media_ext(med)), []).append((d, cid))
        if med.get("type") in _TRANSCRIBE:
            audio.setdefault(mid, []).append((d, cid))     # .txt sidecar rides the audio
    for v in list(owners.values()) + list(audio.values()):
        v.sort()

    moved, skipped, removed = [], [], []
    for name in legacy_media(ctx):
        src = os.path.join(ctx.media, name)
        stem, dot, ext = name.rpartition(".")
        if not dot or not stem.isdigit():
            skipped.append((name, "not a <msg_id>.<ext> name")); continue
        mid = int(stem)
        # A `.txt` is a transcript sidecar ONLY if that message was transcribed —
        # people also send .txt DOCUMENTS, and the extension alone can't tell them
        # apart. History can: the old writer wrote a sidecar unconditionally (it
        # would clobber a same-named document), so a transcript row for this id
        # means the sidecar owns the bytes; no transcript row means a document does.
        if ext == "txt" and mid in transcribed:
            cands = audio.get(mid)
        else:
            cands = owners.get((mid, ext))
        if not cands:
            skipped.append((name, "no message in history owns it")); continue
        cid = cands[0][1]
        dest = media_path(ctx, cid, mid, ext)
        if os.path.exists(dest):
            # Normal once a poller running the new code has already backfilled this
            # message: the same bytes now exist at the correct path. Byte-identical
            # ⇒ the flat copy is provably redundant, so remove it — leaving it would
            # strand it forever and keep `doctor` warning about a layout that is in
            # fact complete. Differing bytes are NOT ours to resolve: report and keep.
            if filecmp.cmp(src, dest, shallow=False):
                if not a.dry_run:
                    os.remove(src)
                removed.append((name, os.path.relpath(dest, ctx.root)))
            else:
                skipped.append((name, "DIFFERS from %s — kept, needs a human"
                                % os.path.relpath(dest, ctx.root)))
            continue
        if not a.dry_run:
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            os.rename(src, dest)
        moved.append((name, ref_str(ctx, cid, mid), os.path.relpath(dest, ctx.root)))

    lost = []
    for (mid, ext), cands in sorted(owners.items()):
        for _d, cid in cands[1:]:
            if not os.path.exists(media_path(ctx, cid, mid, ext)):
                lost.append(ref_str(ctx, cid, mid))

    verb = "would move" if a.dry_run else "moved"
    print("migrate: %s %d file(s)" % (verb, len(moved)))
    for name, ref, dest in moved:
        print("    %-16s %-24s -> %s" % (name, ref, dest))
    if removed:
        print("  %s %d redundant copy/copies (identical file already in place):"
              % ("would remove" if a.dry_run else "removed", len(removed)))
        for name, dest in removed[:5]:
            print("    %-16s == %s" % (name, dest))
        if len(removed) > 5:
            print("    … and %d more" % (len(removed) - 5))
    if skipped:
        print("  %d left in place:" % len(skipped))
        for name, why in skipped:
            print("    %-16s %s" % (name, why))
    if lost:
        print("\n%d message(s) never received their media — a same-numbered message in "
              "another chat held the path:" % len(lost))
        for ref in lost:
            print("    %s" % ref)
        print("→ `tg media` re-downloads them from the file_ids in history (distinct paths now)")
    if a.dry_run:
        print("\n(dry run — nothing moved; re-run without --dry-run)")


