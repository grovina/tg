def cmd_sendpoll(ctx, a):
    # Unlike the other send* commands, the target is NOT a leading positional: the
    # poll options are variadic, so a positional [to] would be ambiguous. Pass it
    # with --to (required — no group default). Topic targeting works as everywhere.
    to = ctx.resolve_chat(_to(a))
    if not (2 <= len(a.options) <= 10):
        die("sendpoll: need 2-10 options (got %d)" % len(a.options), 2)
    quiz = a.quiz is not None
    if quiz and not (0 <= a.quiz < len(a.options)):
        die("sendpoll: --quiz index %d out of range (0..%d)" % (a.quiz, len(a.options) - 1), 2)
    thread = _thread_for(ctx, a.topic, a.topic_id)
    if a.dry_run:
        print("DRY: poll to=%s thread=%s type=%s anon=%s opts=%d" % (
            to, thread or "General", "quiz" if quiz else "regular",
            not a.public, len(a.options)))
        return
    fields = {
        "chat_id": to, "question": a.question,
        "options": json.dumps([{"text": o} for o in a.options], ensure_ascii=False),
        "is_anonymous": "false" if a.public else "true",
    }
    if quiz:
        fields["type"] = "quiz"
        fields["correct_option_id"] = a.quiz
    elif a.multi:                                  # multiple answers only apply to regular polls
        fields["allows_multiple_answers"] = "true"
    if thread:
        fields["message_thread_id"] = thread
    j = api_post(ctx, "sendPoll", fields)
    if not j.get("ok"):
        die("sendpoll failed: %s" % j.get("description"))
    r = j["result"]
    poll_id = (r.get("poll") or {}).get("id")   # ties poll_answer rows back to this poll
    _log_out(ctx, to, r, extra={"text": a.question, "poll": {
        "poll_id": poll_id,
        "type": "quiz" if quiz else "regular", "options": list(a.options),
        "anonymous": not a.public, "multi": bool(a.multi),
        "correct_option_id": a.quiz if quiz else None}})
    nudge = "" if a.public else \
        "  (anonymous — `tg pollstatus` can't show who voted; re-send with --public)"
    print("ok poll msg %s%s" % (r.get("message_id"), nudge))


def _mark_poll_seen(ctx, poll_id, message_id):
    """Stamp a poll REVIEWED (a local meta row — nothing is sent to Telegram). This
    is the `ack` of the poll world: it's what lets `tg pending` tell "votes you have
    looked at" from "votes that landed while you weren't watching". Watermark is the
    review MOMENT, not the last vote's time, so any vote ingested afterwards sorts
    later and re-surfaces the poll."""
    now = int(time.time())
    row = {"kind": "poll_seen", "direction": "meta", "poll_id": poll_id,
           "message_id": message_id, "date": now, "iso": _iso(now)}
    with open(ctx.hist, "a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")


def cmd_pollstatus(ctx, a):
    """Per-option tally of a poll WE sent: who selected each option, and which
    options nobody has selected yet — the 'unchecked checklist items'. Reads the
    poll_answer rows the poller persisted; the latest answer per voter wins (a
    vote change REPLACES, an empty selection retracts). Only meaningful for polls
    sent with `--public` — anonymous polls reveal no individual voters.

    Running this MARKS THE POLL REVIEWED, so it drops out of `tg pending` until a
    new vote arrives.

    Target the poll by its message id (`tg pollstatus 4567` — the id printed by
    sendpoll / shown in watch) or `--poll-id <id>`; with neither, the most recent
    poll in history is used."""
    if not os.path.exists(ctx.hist):
        die("no history yet — poll first", 2)
    want_mid = None
    if getattr(a, "msg_id", None) is not None:
        if not re.fullmatch(r"\d+", str(a.msg_id)):
            die("pollstatus: msg_id must be numeric (the poll's message id)", 2)
        want_mid = int(a.msg_id)
    want_pid = getattr(a, "poll_id", None)
    poll_row, answers = None, {}     # answers: poll_id -> {voter_id: (date, name, option_ids)}
    with open(ctx.hist, encoding="utf-8") as f:
        for line in f:
            try:
                r = json.loads(line)
            except Exception:
                continue
            if r.get("direction") == "out" and r.get("poll"):
                p = r["poll"]
                if want_pid is not None and p.get("poll_id") != want_pid:
                    continue
                if want_mid is not None and r.get("message_id") != want_mid:
                    continue
                poll_row = r                         # keep scanning → most recent match wins
            elif r.get("kind") == "poll_answer" and r.get("poll_id"):
                vid = (r.get("from") or {}).get("id")
                if vid is None:
                    continue
                cur = answers.setdefault(r["poll_id"], {})
                d = r.get("date") or 0
                if vid not in cur or d >= cur[vid][0]:   # latest answer per voter wins
                    cur[vid] = (d, (r.get("from") or {}).get("first_name") or "?",
                                r.get("option_ids") or [])
    if not poll_row:
        die("pollstatus: no matching poll in history — send one with `tg sendpoll` "
            "(and the poller must have ingested the votes)", 2)
    poll = poll_row["poll"]
    pid, options = poll.get("poll_id"), poll.get("options") or []
    mid = poll_row.get("message_id")
    cid = (poll_row.get("chat") or {}).get("id")
    question = poll_row.get("text") or ""
    voters = answers.get(pid, {})
    per_option = {i: [] for i in range(len(options))}
    for _vid, (_d, name, opt_ids) in voters.items():
        for oi in opt_ids:
            if 0 <= oi < len(options):
                per_option[oi].append(name)
    alias = ctx.chat_alias(cid)
    loc = (alias + " " if alias else "") + str(cid)
    active = sum(1 for v in voters.values() if v[2])     # voters with a non-empty selection
    print('poll #%s in [%s]: "%s"  (%d voter%s)' % (
        mid, loc, question, active, "" if active == 1 else "s"))
    if poll.get("anonymous"):
        print("  ⚠ ANONYMOUS poll — Telegram reveals no individual voters; "
              "re-send with `--public` for per-person tracking")
    # Showing the tally IS the review — stamp it before the per-option detail so
    # every exit path below (including the no-options early return) is covered.
    _mark_poll_seen(ctx, pid, mid)
    unchecked = []
    for i, text in enumerate(options):
        names = per_option.get(i, [])
        if not names:
            unchecked.append((i, text))
        print("  [%2d] %-28s %s" % (i, text, ", ".join(sorted(names)) or "—"))
    if not options:
        return
    if unchecked:
        print("unchecked (%d): %s" % (len(unchecked),
              ", ".join("#%d %s" % (i, t) for i, t in unchecked)))
    else:
        print("all options have at least one vote ✓")


