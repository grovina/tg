def cmd_show(ctx, a):
    """Print the FULL stored record for one inbound message id: the complete text
    untruncated, plus sender / chat / thread / date and any media or voice
    transcript. Every `tg watch` line ends with `#<id>`, but the live view (and
    the Monitor that surfaces it) can clip a long message — `tg show <id>`
    recovers the whole thing without hand-grepping var/telegram/history.jsonl."""
    if not os.path.exists(ctx.hist):
        print("no history yet — poll first"); return
    try:
        mid = int(a.msg_id)
    except (TypeError, ValueError):
        die("show: message id must be numeric (got %r)" % a.msg_id, 2)
    hits, transcripts = [], []
    with open(ctx.hist, encoding="utf-8") as f:
        for line in f:
            try:
                r = json.loads(line)
            except Exception:
                continue
            if r.get("message_id") == mid and r.get("direction") == "in" and not r.get("kind"):
                hits.append(r)          # append-only: an edit lands as a later row, same id
            elif r.get("kind") == "transcript" and r.get("ref_message_id") == mid:
                transcripts.append(r)
    if not hits:
        print("no inbound message #%s in history%s" % (
            mid, " (voice transcript only — below)" if transcripts else ""))
        for t in transcripts:
            print("\n[voice transcript]\n%s" % (t.get("text") or ""))
        return
    r = hits[-1]                        # the last row is the current text (edits supersede)
    chat = r.get("chat") or {}
    cid = chat.get("id")
    label = ctx.chat_alias(cid) or chat.get("title") or (
        "DM" if chat.get("type") == "private" else (chat.get("type") or "?"))
    frm = r.get("from") or {}
    who = frm.get("first_name") or "?"
    if frm.get("username"):
        who += " (@%s)" % frm["username"]
    hdr = "#%s  from %s  in [%s%s]" % (mid, who, label, "" if cid is None else " %s" % cid)
    if r.get("thread_id") is not None:
        hdr += " thread %s" % r["thread_id"]
    if r.get("iso"):
        hdr += "  %s" % r["iso"]
    if r.get("edited") or len(hits) > 1:
        hdr += "  (edited)"
    print(hdr)
    med = r.get("media")
    if med:
        print("media: %s%s" % (med.get("type", "media"), _dur(med.get("duration"))))
    txt = r.get("text")
    if txt:
        print()
        print(txt)                      # FULL text, verbatim — the whole point
    elif not med and r.get("raw_keys"):
        print("(no text/media — telegram fields: %s)" % ", ".join(r["raw_keys"]))
    for t in transcripts:
        print("\n[voice transcript]\n%s" % (t.get("text") or ""))


# How far back `pending` looks for polls still awaiting review. A poll has no
# "closed" state we can see, so without a horizon an un-reviewed one would nag
# forever — and a box sending a checklist every morning would accrete them.
POLL_REVIEW_DAYS = 7


def cmd_pending(ctx, _a):
    """Everything still owed your attention — the reconcile backstop a session runs
    after (re-)arming `tg watch`, to catch what landed while the live Monitor was
    down. A pure read of history.jsonl. Two sections:

    MESSAGES — chats (and forum threads) whose latest inbound message is newer than
    our latest reply OR ack there. An `ack` clears a chat without a reply (seen,
    nothing to answer), so chatter/FYIs you won't answer don't linger forever;
    reactions / membership / meta rows don't count as messages to answer; forum
    topics are keyed per-thread so a reply in one thread doesn't mask an unanswered
    message in another.

    POLLS — polls WE sent that have votes we haven't looked at (or that nobody has
    voted on at all). A vote is NOT a message: `poll_answer` carries no chat and no
    text, so the reply/ack watermark above can never reach it, and a vote that lands
    while the Monitor is down is otherwise invisible on EVERY surface — which is the
    whole reason this section exists. `tg pollstatus <id>` is the review, and doing
    it marks the poll seen; a vote arriving afterwards re-surfaces it. Anonymous
    polls are skipped: Telegram never reveals their voters, so there is nothing to
    miss and nothing to reconcile."""
    if not os.path.exists(ctx.hist):
        print("no history yet — poll first"); return
    last_in, last_out, last_ack, who, msgs = {}, {}, {}, {}, {}
    polls, votes, reviewed = {}, {}, {}
    with open(ctx.hist, encoding="utf-8") as f:
        for line in f:
            try:
                r = json.loads(line)
            except Exception:
                continue
            d = r.get("date")
            if d is None:                       # undated rows (failed sends, deletes) carry no ordering
                continue
            kind = r.get("kind")
            # Poll rows are keyed by poll_id, not by chat: a vote has no chat at all,
            # so they're collected here BEFORE the chat-keyed message logic below.
            if kind == "poll_answer" and r.get("poll_id"):
                vid = (r.get("from") or {}).get("id")
                if vid is not None:
                    cur = votes.setdefault(r["poll_id"], {})
                    if vid not in cur or d >= cur[vid][0]:      # latest answer per voter wins
                        cur[vid] = (d, r.get("option_ids") or [])
                continue
            if kind == "poll_seen" and r.get("poll_id"):
                reviewed[r["poll_id"]] = max(d, reviewed.get(r["poll_id"], -1))
                continue
            cid = (r.get("chat") or {}).get("id")
            if cid is None:
                continue
            if r.get("direction") == "out" and r.get("poll"):
                p = r["poll"]
                if p.get("poll_id"):
                    polls[p["poll_id"]] = (d, r)                # re-send of the same poll_id: latest wins
            key = (cid, r.get("thread_id"))
            if r.get("direction") == "in" and not kind:         # real inbound message only
                if d >= last_in.get(key, -1):
                    last_in[key] = d
                    who[key] = (r.get("from") or {}).get("first_name") or "?"
                msgs.setdefault(key, []).append((d, r.get("text") or "[%s]" % (r.get("media") or "non-text"),
                                                 r.get("message_id")))
            elif r.get("direction") == "out":
                last_out[key] = max(d, last_out.get(key, -1))
            elif kind == "ack":                  # seen, no reply needed — clears like a reply
                last_ack[key] = max(d, last_ack.get(key, -1))

    def seen(key):                               # watermark: replied-to OR acked, whichever is later
        return max(last_out.get(key, -1), last_ack.get(key, -1))
    rows = [(din, key) for key, din in last_in.items() if din > seen(key)]

    horizon = time.time() - POLL_REVIEW_DAYS * 86400
    open_polls = []
    for pid, (sent, r) in polls.items():
        p = r["poll"]
        if p.get("anonymous") or sent < horizon:
            continue
        wm = reviewed.get(pid, -1)               # -1 = never reviewed
        v = votes.get(pid, {})
        fresh = sum(1 for (d, _o) in v.values() if d > wm)
        if wm >= 0 and not fresh:                # reviewed, and nothing new since
            continue
        open_polls.append((sent, pid, r, v, fresh, wm < 0))

    if not rows and not open_polls:
        print("all caught up — no unanswered inbound, no polls awaiting review"); return

    for din, key in sorted(rows):
        cid, tid = key
        wm = seen(key)
        unanswered = [(mid, t) for (dd, t, mid) in sorted(msgs.get(key, [])) if dd > wm]
        iso = datetime.datetime.fromtimestamp(din, datetime.UTC).isoformat()
        alias = ctx.chat_alias(cid)
        loc = (alias + " " if alias else "") + str(cid) + ("" if tid is None else " thread %s" % tid)
        print("%-30s %-12s %d unanswered, last %s" % (loc, who.get(key, "?"), len(unanswered), iso))
        for mid, t in unanswered[-3:]:
            print("    #%-9s %s" % (mid, t.replace("\n", " ")[:110]))
    if rows:
        print("→ `tg reply <#id> <text>` to answer in place, or `tg ack <chat>` for anything that needs no answer")

    if not open_polls:
        return
    if rows:
        print()
    print("polls awaiting review (%d):" % len(open_polls))
    for sent, _pid, r, v, fresh, never in sorted(open_polls):
        p = r["poll"]
        options = p.get("options") or []
        picked = {oi for (_d, opts) in v.values() for oi in opts}
        unchecked = [i for i in range(len(options)) if i not in picked]
        voters = sum(1 for (_d, opts) in v.values() if opts)   # a retracted vote isn't a voter
        cid = (r.get("chat") or {}).get("id")
        alias = ctx.chat_alias(cid)
        loc = (alias + " " if alias else "") + str(cid)
        last = max([d for (d, _o) in v.values()], default=None)
        when = datetime.datetime.fromtimestamp(last, datetime.UTC).isoformat() if last else "—"
        tally = "no votes at all" if not voters else "%d voter%s (%d new), %d/%d option%s unchecked, last vote %s" % (
            voters, "" if voters == 1 else "s", fresh,
            len(unchecked), len(options), "" if len(unchecked) == 1 else "s", when)
        print("  #%-9s [%s] %s" % (r.get("message_id"), loc, (r.get("text") or "").replace("\n", " ")[:60]))
        print("    %s%s" % (tally, "  (never reviewed)" if never else ""))
    print("→ `tg pollstatus <#id>` for the per-option tally — reviewing it marks it seen")


def cmd_ack(ctx, a):
    """Mark a chat/thread as SEEN — acknowledged, no reply needed — so it stops
    showing in `tg pending`. Sets a watermark at the latest inbound timestamp there
    at ack time; anything that arrives later re-surfaces. Lets you clear chatter /
    FYIs / thanks you legitimately won't answer without sending a reply. Silent —
    writes only a local history row; to acknowledge VISIBLY to the sender, react
    instead (`tg react`)."""
    to = ctx.resolve_chat(_to(a))
    thread = _thread_for(ctx, a.topic, a.topic_id)
    tid = int(thread) if thread else None
    latest = None
    if os.path.exists(ctx.hist):
        with open(ctx.hist, encoding="utf-8") as f:
            for line in f:
                try:
                    r = json.loads(line)
                except Exception:
                    continue
                if r.get("direction") != "in" or r.get("kind"):
                    continue
                if (r.get("chat") or {}).get("id") != int(to) or r.get("thread_id") != tid:
                    continue
                d = r.get("date")
                if d is not None and (latest is None or d > latest):
                    latest = d
    loc = "%s%s" % (to, "" if tid is None else " thread %s" % tid)
    if latest is None:
        print("ack: nothing inbound to ack in %s" % loc); return
    row = {"kind": "ack", "direction": "meta", "chat": {"id": int(to)}, "thread_id": tid,
           "date": latest, "iso": datetime.datetime.fromtimestamp(latest, datetime.UTC).isoformat()}
    with open(ctx.hist, "a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")
    print("ack: %s — seen through %s" % (loc, row["iso"]))


